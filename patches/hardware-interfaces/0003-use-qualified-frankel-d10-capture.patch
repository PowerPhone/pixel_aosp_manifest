+class CaptureRoute {
+  public:
+    ~CaptureRoute() { cleanup(); }
+
+    bool configure(CaptureEndpoint endpoint) {
+        cleanup();
+        mEndpoint = endpoint;
+        mMixer = mixer_open(kCaptureCard);
+        if (mMixer == nullptr) {
+            LOG(ERROR) << __func__ << ": failed to open mixer card " << kCaptureCard;
+            return false;
+        }
+
+        // The resident D10 profile changes shared D8/D9/D10/D12 firmware code.
+        // Never compose it with a stock capture route or a powered microphone.
+        for (const char* name : kConflictingCaptureRoutes) {
+            if (!requireValue(name, 0)) {
+                closeMixer();
+                return false;
+            }
+        }
+        if (!requireValue(kCaptureRoute, 0)) {
+            closeMixer();
+            return false;
+        }
+        for (const char* name : kCapturePowerControls) {
+            if (!requireValue(name, 0)) {
+                closeMixer();
+                return false;
+            }
+        }
+
+        if (!setEnum("BUILTIN MIC Process Mode", "Raw") ||
+            !setEnum("Audio Capture Mic Source", "Builtin_MIC") ||
+            !setValue("Mic Spatial Module Enable", 0) || !setValue("MIC DC Blocker", 0) ||
+            !setValue("MIC Record Soft Gain (dB)", 0) || !setValue("HD Mic gain (cB)", 0) ||
+            !setEnum("INTERNAL_MIC_TX Sample Rate", "SR_192K") ||
+            !setEnum("INTERNAL_MIC_TX Format", "S16_LE") ||
+            !setEnum("INTERNAL_MIC_TX Chan", "One") || !setCaptureList(logicalMic(endpoint))) {
+            cleanup();
+            return false;
+        }
+
+        mRouteTouched = true;
+        if (!setValue(kCaptureRoute, 1)) {
+            cleanup();
+            return false;
+        }
+        mSetupComplete = true;
+        return verifyOwnership();
+    }
+
+    bool verifyOwnership() {
+        if (mMixer == nullptr || !mSetupComplete || mOwnershipLost) return false;
+        if (!matchesOwnedState()) {
+            mOwnershipLost = true;
+            LOG(ERROR) << "PowerPhone D10 capture mixer ownership drifted; "
+                          "revoking the stream";
+            return false;
+        }
+        return true;
+    }
+
+    void cleanup() {
+        if (mMixer == nullptr) return;
+
+        // PCM closure precedes this method in every StreamPowerphone path. The
+        // route and microphone controls are safety controls, so attempt all of
+        // their hard-off writes even after a partial setup failure.
+        bool hardOff = true;
+        if (mRouteTouched && !setValueBestEffort(kCaptureRoute, 0)) hardOff = false;
+        if (!setValueBestEffort("US Record Enable", 0)) hardOff = false;
+        if (!setValueBestEffort("MIC0", 0)) hardOff = false;
+        if (!setValueBestEffort("MIC1", 0)) hardOff = false;
+        if (!setValueBestEffort("MIC2", 0)) hardOff = false;
+        if (!hardOff) {
+            LOG(ERROR) << "PowerPhone D10 capture cleanup could not prove every "
+                          "route/power control off; reboot is required";
+        }
+        closeMixer();
+    }
+
+  private:
+    static int logicalMic(CaptureEndpoint endpoint) {
+        switch (endpoint) {
+            case CaptureEndpoint::LOGICAL_MIC_0:
+                return 0;
+            case CaptureEndpoint::LOGICAL_MIC_1:
+                return 1;
+            case CaptureEndpoint::LOGICAL_MIC_2:
+                return 2;
+        }
+        return -1;
+    }
+
+    mixer_ctl* control(const std::string& name, unsigned int count) const {
+        mixer_ctl* ctl = mixer_get_ctl_by_name(mMixer, name.c_str());
+        if (ctl == nullptr) {
+            LOG(ERROR) << "missing required mixer control: " << name;
+            return nullptr;
+        }
+        if (mixer_ctl_get_num_values(ctl) != count) {
+            LOG(ERROR) << "mixer control has unexpected width: " << name;
+            return nullptr;
+        }
+        return ctl;
+    }
+
+    bool requireValue(const std::string& name, int expected) const {
+        mixer_ctl* ctl = control(name, 1);
+        if (ctl == nullptr) return false;
+        const int actual = mixer_ctl_get_value(ctl, 0);
+        if (actual != expected) {
+            LOG(ERROR) << "refusing busy capture mixer control " << name << ": expected "
+                       << expected << ", got " << actual;
+            return false;
+        }
+        return true;
+    }
+
+    bool valueMatches(const std::string& name, int expected) const {
+        mixer_ctl* ctl = control(name, 1);
+        if (ctl == nullptr) return false;
+        const int actual = mixer_ctl_get_value(ctl, 0);
+        if (actual != expected) {
+            LOG(ERROR) << "capture mixer ownership mismatch " << name << ": expected " << expected
+                       << ", got " << actual;
+            return false;
+        }
+        return true;
+    }
+
+    bool enumMatches(const std::string& name, const char* expected) const {
+        mixer_ctl* ctl = control(name, 1);
+        if (ctl == nullptr) return false;
+        const int index = mixer_ctl_get_value(ctl, 0);
+        const char* actual = index < 0 ? nullptr : mixer_ctl_get_enum_string(ctl, index);
+        if (actual == nullptr || std::string(actual) != expected) {
+            LOG(ERROR) << "capture mixer ownership mismatch " << name << ": expected " << expected
+                       << ", got " << (actual == nullptr ? "<error>" : actual);
+            return false;
+        }
+        return true;
+    }
+
+    bool setValue(const std::string& name, int value) {
+        mixer_ctl* ctl = control(name, 1);
+        if (ctl == nullptr || mixer_ctl_set_value(ctl, 0, value) != 0 ||
+            mixer_ctl_get_value(ctl, 0) != value) {
+            LOG(ERROR) << "failed to set capture mixer control " << name << '=' << value;
+            mOwnershipLost = true;
+            return false;
+        }
+        return true;
+    }
+
+    bool setEnum(const std::string& name, const char* value) {
+        mixer_ctl* ctl = control(name, 1);
+        if (ctl == nullptr || mixer_ctl_set_enum_by_string(ctl, value) != 0 ||
+            !enumMatches(name, value)) {
+            LOG(ERROR) << "failed to set capture mixer control " << name << '=' << value;
+            mOwnershipLost = true;
+            return false;
+        }
+        return true;
+    }
+
+    bool setCaptureList(int logicalMicId) {
+        mixer_ctl* ctl = control("BUILDIN MIC ID CAPTURE LIST", 4);
+        const std::array<long, 4> wanted{{logicalMicId, -1, -1, -1}};
+        std::array<long, 4> actual{};
+        if (ctl == nullptr || mixer_ctl_set_array(ctl, wanted.data(), wanted.size()) != 0 ||
+            mixer_ctl_get_array(ctl, actual.data(), actual.size()) != 0 || actual != wanted) {
+            LOG(ERROR) << "failed to select exact D10 logical microphone " << logicalMicId;
+            mOwnershipLost = true;
+            return false;
+        }
+        return true;
+    }
+
+    bool captureListMatches() const {
+        if (!mEndpoint.has_value()) return false;
+        mixer_ctl* ctl = control("BUILDIN MIC ID CAPTURE LIST", 4);
+        const std::array<long, 4> expected{{logicalMic(*mEndpoint), -1, -1, -1}};
+        std::array<long, 4> actual{};
+        return ctl != nullptr && mixer_ctl_get_array(ctl, actual.data(), actual.size()) == 0 &&
+               actual == expected;
+    }
+
+    bool matchesOwnedState() const {
+        for (const char* name : kConflictingCaptureRoutes) {
+            if (!valueMatches(name, 0)) return false;
+        }
+        for (const char* name : kCapturePowerControls) {
+            if (!valueMatches(name, 0)) return false;
+        }
+        return valueMatches(kCaptureRoute, 1) && enumMatches("BUILTIN MIC Process Mode", "Raw") &&
+               enumMatches("Audio Capture Mic Source", "Builtin_MIC") &&
+               valueMatches("Mic Spatial Module Enable", 0) && valueMatches("MIC DC Blocker", 0) &&
+               valueMatches("MIC Record Soft Gain (dB)", 0) &&
+               valueMatches("HD Mic gain (cB)", 0) &&
+               enumMatches("INTERNAL_MIC_TX Sample Rate", "SR_192K") &&
+               enumMatches("INTERNAL_MIC_TX Format", "S16_LE") &&
+               enumMatches("INTERNAL_MIC_TX Chan", "One") && captureListMatches();
+    }
+
+    bool setValueBestEffort(const std::string& name, int value) {
+        mixer_ctl* ctl = mixer_get_ctl_by_name(mMixer, name.c_str());
+        if (ctl == nullptr || mixer_ctl_set_value(ctl, 0, value) != 0 ||
+            mixer_ctl_get_value(ctl, 0) != value) {
+            LOG(ERROR) << "capture cleanup failed for mixer control " << name;
+            return false;
+        }
+        return true;
+    }
+
+    void closeMixer() {
+        mEndpoint.reset();
+        mRouteTouched = false;
+        mSetupComplete = false;
+        mOwnershipLost = false;
+        mixer_close(mMixer);
+        mMixer = nullptr;
+    }
+
+    mixer* mMixer = nullptr;
+    std::optional<CaptureEndpoint> mEndpoint;
+    bool mRouteTouched = false;
+    bool mSetupComplete = false;
+    bool mOwnershipLost = false;
+};
 
