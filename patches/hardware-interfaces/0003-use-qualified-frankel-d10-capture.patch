+int32_t ModulePowerphone::getNominalLatencyMs(const AudioPortConfig&) {
+    // Baseline for any future non-qualified profile. Exact Frankel 192 kHz
+    // streams use the live-qualified geometry below instead of this rounded
+    // latency-derived size.
+    return 20;
+}
+
+ndk::ScopedAStatus ModulePowerphone::calculateBufferSizeFrames(const AudioFormatDescription& format,
+                                                               const AudioIoFlags& flags,
+                                                               int32_t latencyMs,
+                                                               int32_t sampleRateHz,
+                                                               int32_t* bufferSizeFrames) {
+    const bool exactInput = flags.getTag() == AudioIoFlags::Tag::input &&
+                            format.type == AudioFormatType::PCM &&
+                            format.pcm == PcmType::INT_16_BIT;
+    const bool exactOutput = flags.getTag() == AudioIoFlags::Tag::output &&
+                             format.type == AudioFormatType::PCM &&
+                             format.pcm == PcmType::INT_32_BIT;
+    if (sampleRateHz == kRate && (exactInput || exactOutput)) {
+        // The attached-device tinyalsa adapter divides this total by its default
+        // period_count=4.  7680 therefore yields the live-qualified 1920x4
+        // ALSA geometry on both PCM0,D10 capture and PCM0,D28 playback, and
+        // both values are multiples of the 96-frame AoC quantum.
+        *bufferSizeFrames = 7680;
+        return ndk::ScopedAStatus::ok();
+    }
+    return Module::calculateBufferSizeFrames(format, flags, latencyMs, sampleRateHz,
+                                             bufferSizeFrames);
 }
 
