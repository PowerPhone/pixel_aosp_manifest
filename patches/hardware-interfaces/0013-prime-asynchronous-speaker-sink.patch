From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: PowerPhone Build <powerphone@example.invalid>
Date: Thu, 4 Sep 2026 05:05:00 +0000
Subject: [PATCH] audio: prime the asynchronous AoC speaker sink

Starting D0 begins an AoC sink setup interval longer than its four-period
kernel ring. Prime the sink with silence until 80 ms of consecutive periods
complete without a new xrun, hide only those pre-client startup xruns, and
retain fatal xrun handling for every client transfer.
---
diff --git a/audio/aidl/default/powerphone/Powerphone.cpp b/audio/aidl/default/powerphone/Powerphone.cpp
--- a/audio/aidl/default/powerphone/Powerphone.cpp
+++ b/audio/aidl/default/powerphone/Powerphone.cpp
@@ -20,6 +20,7 @@
 
 #include <algorithm>
 #include <array>
+#include <chrono>
 #include <cstdint>
 #include <limits>
 #include <memory>
@@ -67,6 +68,8 @@ constexpr size_t kCaptureAlsaPeriodFrames = 1920;
 constexpr size_t kCaptureAlsaBufferFrames = 7680;
 constexpr size_t kPlaybackAlsaPeriodFrames = 480;
 constexpr size_t kPlaybackAlsaBufferFrames = 1920;
+constexpr size_t kPlaybackPrimeStablePeriods = 32;
+constexpr std::chrono::milliseconds kPlaybackPrimeTimeout{2500};
 constexpr size_t kFrameworkBufferFrames = 1920;
 constexpr char kCaptureReadyProperty[] = "vendor.powerphone.pdm.ready";
 constexpr char kSpeakerReadyProperty[] = "vendor.powerphone.aoc_speaker_192k.ready";
@@ -1240,6 +1243,44 @@ std::vector<alsa::DeviceProfile> StreamPowerphone::getDeviceProfiles() {
         cleanupPlaybackRouteLocked();
         return ready ? ::android::INVALID_OPERATION : ::android::PERMISSION_DENIED;
     }
+
+    // Starting D0 also starts the asynchronous AoC speaker sink. Its initial
+    // lock/setup interval is longer than the four-period kernel ring, so prime
+    // with silence and discard startup xruns until 80 ms of consecutive full
+    // hardware periods have transferred cleanly. Client audio is not consumed
+    // until this completes, and all later xruns remain fatal.
+    alsa_device_proxy* playbackProxy = mAlsaDeviceProxies.front().get();
+    std::array<int32_t, kPlaybackAlsaPeriodFrames * 2> silence{};
+    size_t stablePeriods = 0;
+    const auto primeDeadline = std::chrono::steady_clock::now() + kPlaybackPrimeTimeout;
+    while (stablePeriods < kPlaybackPrimeStablePeriods &&
+           std::chrono::steady_clock::now() < primeDeadline) {
+        const int xrunsBefore = pcm_get_xruns(playbackProxy->pcm);
+        const int writtenFrames =
+                pcm_writei(playbackProxy->pcm, silence.data(), kPlaybackAlsaPeriodFrames);
+        const int xrunsAfter = pcm_get_xruns(playbackProxy->pcm);
+        if (writtenFrames == static_cast<int>(kPlaybackAlsaPeriodFrames) &&
+            xrunsAfter == xrunsBefore) {
+            ++stablePeriods;
+        } else {
+            stablePeriods = 0;
+        }
+    }
+    if (stablePeriods != kPlaybackPrimeStablePeriods) {
+        const char* error = pcm_get_error(playbackProxy->pcm);
+        LOG(ERROR) << __func__ << ": speaker PCM did not stabilize during silent priming: "
+                   << "stable_periods=" << stablePeriods
+                   << ", xruns=" << pcm_get_xruns(playbackProxy->pcm)
+                   << ", pcm_error=" << (error == nullptr ? "<none>" : error);
+        StreamAlsa::standby();
+        std::lock_guard lock(mLock);
+        cleanupPlaybackRouteLocked();
+        return ::android::INVALID_OPERATION;
+    }
+    const int startupXruns = pcm_get_xruns(playbackProxy->pcm);
+    mPlaybackXrunsBaseline.store(startupXruns, std::memory_order_release);
+    LOG(INFO) << __func__ << ": speaker PCM primed with " << startupXruns
+              << " startup xrun(s); steady-state transfers are now strict";
     return ::android::OK;
 }
 
@@ -1353,12 +1394,14 @@ std::vector<alsa::DeviceProfile> StreamPowerphone::getDeviceProfiles() {
         return ready ? ::android::INVALID_OPERATION : ::android::PERMISSION_DENIED;
     }
     alsa_device_proxy* playbackProxy = mAlsaDeviceProxies.front().get();
+    const int expectedXruns = mPlaybackXrunsBaseline.load(std::memory_order_acquire);
     const int initialXruns = pcm_get_xruns(playbackProxy->pcm);
-    if (initialXruns != 0 || mFrameSizeBytes == 0 ||
+    if (initialXruns != expectedXruns || mFrameSizeBytes == 0 ||
         frameCount > std::numeric_limits<size_t>::max() / mFrameSizeBytes) {
         const char* error = pcm_get_error(playbackProxy->pcm);
         LOG(ERROR) << __func__ << ": refusing invalid playback transfer: frames=" << frameCount
                    << ", frame_size=" << mFrameSizeBytes << ", xruns=" << initialXruns
+                   << " (expected " << expectedXruns << ')'
                    << ", pcm_error=" << (error == nullptr ? "<none>" : error);
         StreamAlsa::standby();
         {
@@ -1385,7 +1428,7 @@ std::vector<alsa::DeviceProfile> StreamPowerphone::getDeviceProfiles() {
                                                      static_cast<unsigned int>(chunkBytes),
                                                      mReadWriteRetries);
         const int xrunsAfter = pcm_get_xruns(playbackProxy->pcm);
-        if (writeStatus != 0 || xrunsAfter != initialXruns) {
+        if (writeStatus != 0 || xrunsAfter != expectedXruns) {
             const char* error = pcm_get_error(playbackProxy->pcm);
             LOG(ERROR) << __func__ << ": PCM period write failed after " << transferredFrames
                        << " frames: status=" << writeStatus << ", oversized=" << oversized
@@ -1430,6 +1473,7 @@ void StreamPowerphone::cleanupCaptureRouteLocked() {
 }
 
 void StreamPowerphone::cleanupPlaybackRouteLocked() {
+    mPlaybackXrunsBaseline.store(0, std::memory_order_release);
     if (mPlaybackRoute != nullptr) {
         mPlaybackRoute->cleanup();
         mPlaybackRoute.reset();
diff --git a/audio/aidl/default/powerphone/Powerphone.h b/audio/aidl/default/powerphone/Powerphone.h
--- a/audio/aidl/default/powerphone/Powerphone.h
+++ b/audio/aidl/default/powerphone/Powerphone.h
@@ -16,6 +16,7 @@
 
 #pragma once
 
+#include <atomic>
 #include <memory>
 #include <mutex>
 #include <optional>
@@ -70,6 +71,7 @@ class StreamPowerphone : public StreamAlsa {
     std::optional<PlaybackEndpoint> mPlaybackEndpoint GUARDED_BY(mLock);
     std::unique_ptr<PlaybackRoute> mPlaybackRoute GUARDED_BY(mLock);
     bool mOwnsPlaybackLease GUARDED_BY(mLock) = false;
+    std::atomic<int> mPlaybackXrunsBaseline{0};
 };
 
 class StreamInPowerphone final : public StreamIn, public StreamPowerphone {
