+
+#include <errno.h>
+#include <limits.h>
+
+#include <array>
+#include <string>
+#include <vector>
+
+#include <gtest/gtest.h>
+#include <powerphone/LegacyTinyalsaV1.h>
+#include <tinyalsa/asoundlib.h>
+
+namespace {
+
+constexpr size_t kParamCount = PCM_PARAM_TICK_TIME + 1;
+
+struct FakePcm {
+    bool ready = true;
+    unsigned int bufferSize = 1920;
+};
+
+struct FakeParams {
+    std::array<unsigned int, kParamCount> minimum{};
+    std::array<unsigned int, kParamCount> maximum{};
+};
+
+FakePcm gPcm;
+FakeParams gParams;
+bool gParamsAvailable;
+int gParamsFailureErrno;
+std::vector<std::string> gOperations;
+std::vector<pcm_param> gMinimumQueries;
+std::vector<pcm_param> gMaximumQueries;
+unsigned int gOpenCard;
+unsigned int gOpenDevice;
+unsigned int gOpenFlags;
+pcm_config gOpenConfig;
+
+void ResetFakes() {
+    gPcm = {};
+    gParams = {};
+    gParams.maximum.fill(UINT_MAX);
+    gParamsAvailable = true;
+    gParamsFailureErrno = EBUSY;
+    gOperations.clear();
+    gMinimumQueries.clear();
+    gMaximumQueries.clear();
+    gOpenCard = UINT_MAX;
+    gOpenDevice = UINT_MAX;
+    gOpenFlags = UINT_MAX;
+    gOpenConfig = {};
+    errno = 0;
+}
+
+std::vector<pcm_param> ExpectedQueries() {
+    return {
+            PCM_PARAM_RATE,
+            PCM_PARAM_CHANNELS,
+            PCM_PARAM_SAMPLE_BITS,
+            PCM_PARAM_PERIOD_SIZE,
+            PCM_PARAM_PERIODS,
+    };
+}
+
+class LegacyTinyalsaV1Test : public ::testing::Test {
+  protected:
+    void SetUp() override { ResetFakes(); }
+};
+
+TEST_F(LegacyTinyalsaV1Test, PreflightsBeforeConfiguredOpen) {
+    powerphone_legacy_pcm_open_result result{};
+
+    powerphone_legacy_pcm* pcm = powerphone_legacy_pcm_open_playback(
+            0, 0, 2, 192000, 480, 4, POWERPHONE_LEGACY_PCM_FORMAT_S32_LE, &result);
+
+    ASSERT_NE(nullptr, pcm);
+    EXPECT_EQ((std::vector<std::string>{"params_get", "params_free", "pcm_open"}),
+              gOperations);
+    EXPECT_EQ(ExpectedQueries(), gMinimumQueries);
+    EXPECT_EQ(ExpectedQueries(), gMaximumQueries);
+    EXPECT_EQ(0u, gOpenCard);
+    EXPECT_EQ(0u, gOpenDevice);
+    EXPECT_EQ(static_cast<unsigned int>(PCM_OUT), gOpenFlags);
+    EXPECT_EQ(2u, gOpenConfig.channels);
+    EXPECT_EQ(192000u, gOpenConfig.rate);
+    EXPECT_EQ(480u, gOpenConfig.period_size);
+    EXPECT_EQ(4u, gOpenConfig.period_count);
+    EXPECT_EQ(PCM_FORMAT_S32_LE, gOpenConfig.format);
+    EXPECT_EQ(0u, gOpenConfig.start_threshold);
+    EXPECT_EQ(0u, gOpenConfig.stop_threshold);
+    EXPECT_EQ(0u, gOpenConfig.silence_threshold);
+    EXPECT_EQ(0u, gOpenConfig.silence_size);
+    EXPECT_EQ(0, gOpenConfig.avail_min);
+    EXPECT_EQ(480u, result.period_size_frames);
+    EXPECT_EQ(4u, result.period_count);
+    EXPECT_EQ(1920u, result.buffer_size_frames);
+}
+
+TEST_F(LegacyTinyalsaV1Test, RejectsOutOfRangeAfterCompletePreflight) {
+    gParams.maximum[PCM_PARAM_RATE] = 96000;
+
+    powerphone_legacy_pcm* pcm = powerphone_legacy_pcm_open_playback(
+            0, 0, 2, 192000, 480, 4, POWERPHONE_LEGACY_PCM_FORMAT_S32_LE, nullptr);
+
+    EXPECT_EQ(nullptr, pcm);
+    EXPECT_EQ(EINVAL, errno);
+    EXPECT_EQ((std::vector<std::string>{"params_get", "params_free"}), gOperations);
+    EXPECT_EQ(ExpectedQueries(), gMinimumQueries);
+    EXPECT_EQ(ExpectedQueries(), gMaximumQueries);
+}
+
+TEST_F(LegacyTinyalsaV1Test, PreservesParameterOpenFailure) {
+    gParamsAvailable = false;
+    gParamsFailureErrno = ENODEV;
+
+    powerphone_legacy_pcm* pcm = powerphone_legacy_pcm_open_playback(
+            0, 0, 2, 192000, 480, 4, POWERPHONE_LEGACY_PCM_FORMAT_S32_LE, nullptr);
+
+    EXPECT_EQ(nullptr, pcm);
+    EXPECT_EQ(ENODEV, errno);
+    EXPECT_EQ((std::vector<std::string>{"params_get"}), gOperations);
+}
+
+TEST_F(LegacyTinyalsaV1Test, MapsS16FormatToSixteenSampleBits) {
+    gParams.minimum[PCM_PARAM_SAMPLE_BITS] = 16;
+    gParams.maximum[PCM_PARAM_SAMPLE_BITS] = 16;
+
+    powerphone_legacy_pcm* pcm = powerphone_legacy_pcm_open_playback(
+            0, 0, 2, 192000, 480, 4, POWERPHONE_LEGACY_PCM_FORMAT_S16_LE, nullptr);
+
+    ASSERT_NE(nullptr, pcm);
+    EXPECT_EQ(PCM_FORMAT_S16_LE, gOpenConfig.format);
+}
+
+}  // namespace
+
+struct pcm {
+    FakePcm* fake;
+};
+
+struct pcm_params {
+    FakeParams* fake;
+};
+
+extern "C" {
+
+struct pcm_params* pcm_params_get(unsigned int card, unsigned int device, unsigned int flags) {
+    gOperations.emplace_back("params_get");
+    EXPECT_EQ(0u, card);
+    EXPECT_EQ(0u, device);
+    EXPECT_EQ(static_cast<unsigned int>(PCM_OUT), flags);
+    if (!gParamsAvailable) {
+        errno = gParamsFailureErrno;
+        return nullptr;
+    }
+    static pcm_params params{&gParams};
+    return &params;
+}
+
+void pcm_params_free(struct pcm_params* params) {
+    gOperations.emplace_back("params_free");
+    EXPECT_NE(nullptr, params);
+}
+
+unsigned int pcm_params_get_min(const struct pcm_params* params, enum pcm_param param) {
+    gMinimumQueries.push_back(param);
+    return params->fake->minimum[param];
+}
+
+unsigned int pcm_params_get_max(const struct pcm_params* params, enum pcm_param param) {
+    gMaximumQueries.push_back(param);
+    return params->fake->maximum[param];
+}
+
+struct pcm* pcm_open(unsigned int card, unsigned int device, unsigned int flags,
+                     struct pcm_config* config) {
+    gOperations.emplace_back("pcm_open");
+    gOpenCard = card;
+    gOpenDevice = device;
+    gOpenFlags = flags;
+    gOpenConfig = *config;
+    static pcm pcm{&gPcm};
+    return &pcm;
+}
+
+int pcm_close(struct pcm*) {
+    return 0;
+}
+
+int pcm_is_ready(struct pcm* pcm) {
+    return pcm->fake->ready;
+}
+
+const char* pcm_get_error(struct pcm*) {
+    return "fake pcm error";
+}
+
+unsigned int pcm_get_buffer_size(struct pcm* pcm) {
+    return pcm->fake->bufferSize;
+}
+
+int pcm_write(struct pcm*, const void*, unsigned int) {
+    return 0;
+}
+
+int pcm_stop(struct pcm*) {
+    return 0;
+}
+
+int pcm_get_xruns(struct pcm*) {
+    return 0;
+}
+
+}  // extern "C"

