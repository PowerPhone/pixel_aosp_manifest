From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: PowerPhone Build <powerphone@example.invalid>
Date: Fri, 4 Sep 2026 12:20:00 +0000
Subject: [PATCH] audio: match tinyplay PCM parameter preflight

The qualified legacy tinyplay transaction does more than open its configured
PCM: sample_is_playable() first calls pcm_params_get(), which opens PCM0,D0,
issues HW_REFINE, and closes it. Frankel's AoC PCM open and close paths allocate
and release the service, workqueue, ring snapshot, and interrupt handler, so
omitting this preflight changes the hardware-visible lifecycle.

Reproduce tinyplay's temporary PCM_OUT parameters transaction and all five of
its range checks before the facade's real configured open. Preserve the
original errno when the parameter open itself fails, and report EINVAL when
the requested geometry is outside the refined bounds.

Add a focused facade test that proves params-get/free precedes the configured
open, every tinyplay bound is queried, unsupported geometry never reaches the
real open, parameter-open errno is preserved, and S16 maps to 16 sample bits.
---
 audio/aidl/default/Android.bp                      |  18 ++
 audio/aidl/default/powerphone/LegacyTinyalsaV1.c   |  32 +++
 .../powerphone/tests/LegacyTinyalsaV1Test.cpp      | 229 +++++++++++++++++++++
 3 files changed, 279 insertions(+)

diff --git a/audio/aidl/default/Android.bp b/audio/aidl/default/Android.bp
index 0f72e37812..2f3e88a71e 100644
--- a/audio/aidl/default/Android.bp
+++ b/audio/aidl/default/Android.bp
@@ -238,6 +238,24 @@ cc_library_shared {
     stl: "none",
 }
 
+cc_test {
+    name: "powerphone_legacy_tinyalsa_v1_tests",
+    host_supported: true,
+    vendor_available: true,
+    srcs: [
+        "powerphone/LegacyTinyalsaV1.c",
+        "powerphone/tests/LegacyTinyalsaV1Test.cpp",
+    ],
+    include_dirs: ["external/tinyalsa/include"],
+    local_include_dirs: ["powerphone/include"],
+    cflags: [
+        "-Wall",
+        "-Wextra",
+        "-Werror",
+    ],
+    test_suites: ["general-tests"],
+}
+
 cc_binary {
     name: "android.hardware.audio.service-aidl.powerphone",
     relative_install_path: "hw",
diff --git a/audio/aidl/default/powerphone/LegacyTinyalsaV1.c b/audio/aidl/default/powerphone/LegacyTinyalsaV1.c
index c23be8f756..fe994cb2fa 100644
--- a/audio/aidl/default/powerphone/LegacyTinyalsaV1.c
+++ b/audio/aidl/default/powerphone/LegacyTinyalsaV1.c
@@ -41,12 +41,20 @@ static struct pcm* unwrap(struct powerphone_legacy_pcm* pcm) {
     return (struct pcm*)pcm;
 }
 
+static int parameter_in_range(const struct pcm_params* params, enum pcm_param param,
+                              uint32_t value) {
+    return value >= pcm_params_get_min(params, param) &&
+           value <= pcm_params_get_max(params, param);
+}
+
 struct powerphone_legacy_pcm* powerphone_legacy_pcm_open_playback(
         uint32_t card, uint32_t device, uint32_t channels, uint32_t rate,
         uint32_t period_size_frames, uint32_t period_count, uint32_t format,
         struct powerphone_legacy_pcm_open_result* result) {
     struct pcm_config config;
     enum pcm_format legacy_format;
+    uint32_t sample_bits;
+    struct pcm_params* params;
     struct pcm* pcm;
 
     if (result != NULL) {
@@ -59,9 +67,11 @@ struct powerphone_legacy_pcm* powerphone_legacy_pcm_open_playback(
     switch (format) {
         case POWERPHONE_LEGACY_PCM_FORMAT_S16_LE:
             legacy_format = PCM_FORMAT_S16_LE;
+            sample_bits = 16;
             break;
         case POWERPHONE_LEGACY_PCM_FORMAT_S32_LE:
             legacy_format = PCM_FORMAT_S32_LE;
+            sample_bits = 32;
             break;
         default:
             errno = EINVAL;
@@ -81,6 +91,28 @@ struct powerphone_legacy_pcm* powerphone_legacy_pcm_open_playback(
      * avail_min of one frame.
      */
 
+    /*
+     * Match tinyplay's complete device transaction, including its
+     * sample_is_playable() preflight. pcm_params_get() performs a temporary
+     * PCM_OUT open, HW_REFINE, and close before the real configured open.
+     * That lifecycle is observable by Frankel's AoC driver, so this must not
+     * be reduced to a cached/static capability check.
+     */
+    params = pcm_params_get(card, device, PCM_OUT);
+    if (params == NULL) {
+        return NULL;
+    }
+    int playable = parameter_in_range(params, PCM_PARAM_RATE, rate);
+    playable &= parameter_in_range(params, PCM_PARAM_CHANNELS, channels);
+    playable &= parameter_in_range(params, PCM_PARAM_SAMPLE_BITS, sample_bits);
+    playable &= parameter_in_range(params, PCM_PARAM_PERIOD_SIZE, period_size_frames);
+    playable &= parameter_in_range(params, PCM_PARAM_PERIODS, period_count);
+    pcm_params_free(params);
+    if (!playable) {
+        errno = EINVAL;
+        return NULL;
+    }
+
     pcm = pcm_open(card, device, PCM_OUT, &config);
     if (pcm != NULL && pcm_is_ready(pcm) && result != NULL) {
         result->period_size_frames = config.period_size;
diff --git a/audio/aidl/default/powerphone/tests/LegacyTinyalsaV1Test.cpp b/audio/aidl/default/powerphone/tests/LegacyTinyalsaV1Test.cpp
new file mode 100644
index 0000000000..1bb64ecd24
--- /dev/null
+++ b/audio/aidl/default/powerphone/tests/LegacyTinyalsaV1Test.cpp
@@ -0,0 +1,229 @@
