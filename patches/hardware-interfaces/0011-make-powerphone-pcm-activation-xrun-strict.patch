From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: PowerPhone Build <powerphone@example.invalid>
Date: Thu, 4 Sep 2026 02:40:00 +0000
Subject: [PATCH] audio: make PowerPhone PCM activation xrun-strict

Zero-initialize ALSA profiles and PCM configurations so tinyalsa never consumes
indeterminate software-threshold fields. Bind each timing-sensitive AoC route
with the final mixer ioctl before opening PCM, and defer full ownership audits
until PCM has closed.

Keep the 40 ms framework queue decoupled from PCM0,D0's fixed 480x4 hardware
buffer, but submit one 480-frame period at a time. Treat any tinyalsa xrun,
including an internally recovered one, as an integrity failure and report both
the xrun transition and PCM error.
---
diff --git a/audio/aidl/default/alsa/UtilsAlsa.cpp b/audio/aidl/default/alsa/UtilsAlsa.cpp
--- a/audio/aidl/default/alsa/UtilsAlsa.cpp
+++ b/audio/aidl/default/alsa/UtilsAlsa.cpp
@@ -44,7 +44,7 @@
 DeviceProxy::DeviceProxy() : mProfile(nullptr), mProxy(nullptr, alsaProxyDeleter) {}
 
 DeviceProxy::DeviceProxy(const DeviceProfile& deviceProfile)
-    : mProfile(new alsa_device_profile), mProxy(new alsa_device_proxy, alsaProxyDeleter) {
+    : mProfile(new alsa_device_profile{}), mProxy(new alsa_device_proxy, alsaProxyDeleter) {
     profile_init(mProfile.get(), deviceProfile.direction);
     mProfile->card = deviceProfile.card;
     mProfile->device = deviceProfile.device;
@@ -374,7 +374,7 @@
 }
 
 std::optional<struct pcm_config> getPcmConfig(const StreamContext& context, bool isInput) {
-    struct pcm_config config;
+    struct pcm_config config{};
     config.channels = alsa::getChannelCountFromChannelMask(context.getChannelLayout(), isInput);
     if (config.channels == 0) {
         LOG(ERROR) << __func__ << ": invalid channel=" << context.getChannelLayout().toString();
