+ * limitations under the License.
+ */
+
+#include <cstdlib>
+
+#define LOG_TAG "AHAL_PowerphoneMain"
+#include <Log.h>
+#include <android/binder_ibinder_platform.h>
+#include <android/binder_manager.h>
+#include <android/binder_process.h>
+
+#include "Powerphone.h"
+
+using aidl::android::hardware::audio::core::Module;
+using aidl::android::hardware::audio::core::powerphone::ModulePowerphone;
+using aidl::android::hardware::audio::core::powerphone::makeConfiguration;
+
+int main() {
+    ABinderProcess_setThreadPoolMaxThreadCount(8);
+    ABinderProcess_startThreadPool();
+
+    auto module = ndk::SharedRefBase::make<ModulePowerphone>(makeConfiguration());
+    const std::string instance = std::string(Module::descriptor) + "/powerphone";
+    const binder_status_t status = AServiceManager_addService(module->asBinder().get(),
+                                                              instance.c_str());
+    if (status != STATUS_OK) {
+        LOG(ERROR) << "failed to register " << instance << ": " << status;
+        return EXIT_FAILURE;
+    }
+    LOG(INFO) << "registered " << instance;
+    ABinderProcess_joinThreadPool();
+    return EXIT_FAILURE;
+}
diff --git a/audio/aidl/default/powerphone/android.hardware.audio.service-aidl.powerphone.rc b/audio/aidl/default/powerphone/android.hardware.audio.service-aidl.powerphone.rc
new file mode 100644
index 0000000000..90050e9a6e
--- /dev/null
+++ b/audio/aidl/default/powerphone/android.hardware.audio.service-aidl.powerphone.rc
@@ -0,0 +1,19 @@
+service vendor.audio-hal-powerphone /vendor/bin/hw/android.hardware.audio.service-aidl.powerphone
+    class hal
+    disabled
+    user audioserver
+    group audio
+    capabilities BLOCK_SUSPEND SYS_NICE
+    rlimit rtprio 10 10
+    ioprio rt 4
+    task_profiles ProcessCapacityHigh HighPerformance
+    onrestart restart audioserver
+
+# A dedicated, fail-closed loader owns this property. It may set the value to
+# one only after validating the stock card 0, exact frankel_pdm_alsa module
+# parameters, polling_enabled=0, and the fixed card-1 PCM topology.
+on property:vendor.powerphone.pdm.ready=0
+    stop vendor.audio-hal-powerphone
+
+on property:vendor.powerphone.pdm.ready=1
+    start vendor.audio-hal-powerphone
