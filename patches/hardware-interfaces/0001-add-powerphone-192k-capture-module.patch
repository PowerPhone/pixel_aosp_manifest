--- a/audio/aidl/default/Android.bp
+++ b/audio/aidl/default/Android.bp
@@ -209,6 +209,45 @@ cc_binary {
     installable: false, //installed in apex com.android.hardware.audio
 }
 
+// Opt-in research module for direct, exact-rate capture from Frankel's
+// controller-backed ALSA card. This is intentionally a separate IModule: it
+// does not replace the vendor primary module or register IConfig/effects.
+cc_binary {
+    name: "android.hardware.audio.service-aidl.powerphone",
+    relative_install_path: "hw",
+    defaults: [
+        "aidlaudioservice_defaults",
+        "latest_android_hardware_audio_core_sounddose_ndk_shared",
+        "latest_android_hardware_audio_core_ndk_shared",
+        "latest_android_hardware_bluetooth_audio_ndk_shared",
+        "latest_android_media_audio_common_types_ndk_shared",
+    ],
+    static_libs: [
+        "libaudioserviceexampleimpl",
+    ],
+    shared_libs: [
+        "android.hardware.bluetooth.audio-impl",
+        "libaudio_aidl_conversion_common_ndk",
+        "libbluetooth_audio_session_aidl",
+        "liblog",
+        "libmedia_helper",
+        "libstagefright_foundation",
+    ],
+    srcs: [
+        "powerphone/Powerphone.cpp",
+        "powerphone/main.cpp",
+    ],
+    init_rc: ["powerphone/android.hardware.audio.service-aidl.powerphone.rc"],
+    vintf_fragments: ["powerphone/android.hardware.audio.service-aidl.powerphone.xml"],
+    cflags: [
+        "-Wall",
+        "-Wextra",
+        "-Werror",
+        "-Wthread-safety",
+        "-DBACKEND_NDK",
+    ],
+}
+
 cc_test {
     name: "audio_policy_config_xml_converter_tests",
     vendor_available: true,
