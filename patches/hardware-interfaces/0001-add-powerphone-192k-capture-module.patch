--- /dev/null
+++ b/audio/aidl/default/powerphone/Powerphone.cpp
@@ -0,0 +1,230 @@
+/*
+ * Copyright (C) 2026 The Android Open Source Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#define LOG_TAG "AHAL_Powerphone"
+
+#include "Powerphone.h"
+
+#include <array>
+#include <cstdio>
+#include <string>
+
+#include <Log.h>
+
+using aidl::android::hardware::audio::common::SinkMetadata;
+using aidl::android::hardware::audio::common::SourceMetadata;
+using aidl::android::media::audio::common::AudioChannelLayout;
+using aidl::android::media::audio::common::AudioDevice;
+using aidl::android::media::audio::common::AudioDeviceAddress;
+using aidl::android::media::audio::common::AudioDeviceType;
+using aidl::android::media::audio::common::AudioFormatDescription;
+using aidl::android::media::audio::common::AudioFormatType;
+using aidl::android::media::audio::common::AudioGainConfig;
+using aidl::android::media::audio::common::AudioIoFlags;
+using aidl::android::media::audio::common::AudioOffloadInfo;
+using aidl::android::media::audio::common::AudioPort;
+using aidl::android::media::audio::common::AudioPortConfig;
+using aidl::android::media::audio::common::AudioPortDeviceExt;
+using aidl::android::media::audio::common::AudioPortExt;
+using aidl::android::media::audio::common::AudioPortMixExt;
+using aidl::android::media::audio::common::AudioProfile;
+using aidl::android::media::audio::common::Int;
+using aidl::android::media::audio::common::MicrophoneInfo;
+using aidl::android::media::audio::common::PcmType;
+
+namespace aidl::android::hardware::audio::core::powerphone {
+namespace {
+
+constexpr int32_t kCard = 1;
+constexpr int32_t kRate = 192000;
+
+struct Endpoint {
+    const char* name;
+    const char* address;
+    AudioDeviceType type;
+    int32_t device;
+};
+
+// PDM wiring is established, but enclosure-hole mapping is not. The two
+// Android device types below merely keep three logical built-in routes
+// distinguishable until live acoustic calibration supplies physical names.
+constexpr std::array<Endpoint, 3> kEndpoints{{
+        {"PowerPhone DMIC1 (PDM0)", "CARD_1_DEV_0", AudioDeviceType::IN_MICROPHONE, 0},
+        {"PowerPhone DMIC2 (PDM2)", "CARD_1_DEV_2", AudioDeviceType::IN_MICROPHONE, 2},
+        {"PowerPhone DMIC3 (PDM3)", "CARD_1_DEV_3", AudioDeviceType::IN_MICROPHONE_BACK, 3},
+}};
+
+AudioDevice makeAudioDevice(const Endpoint& endpoint) {
+    AudioDevice device;
+    device.type.type = endpoint.type;
+    device.type.connection = "";
+    device.address = AudioDeviceAddress::make<AudioDeviceAddress::Tag::id>(endpoint.address);
+    return device;
+}
+
+AudioPortExt makeDeviceExt(const Endpoint& endpoint) {
+    AudioPortDeviceExt deviceExt;
+    deviceExt.device = makeAudioDevice(endpoint);
+    return AudioPortExt::make<AudioPortExt::Tag::device>(std::move(deviceExt));
+}
+
+AudioPortExt makeMixExt() {
+    AudioPortMixExt mixExt;
+    mixExt.maxOpenStreamCount = 1;
+    mixExt.maxActiveStreamCount = 1;
+    return AudioPortExt::make<AudioPortExt::Tag::mix>(std::move(mixExt));
+}
+
+AudioProfile makeProfile() {
+    return AudioProfile{
+            .format = AudioFormatDescription{.type = AudioFormatType::PCM,
+                                             .pcm = PcmType::INT_32_BIT},
+            .channelMasks = {AudioChannelLayout::make<AudioChannelLayout::Tag::layoutMask>(
+                    AudioChannelLayout::LAYOUT_MONO)},
+            .sampleRates = {kRate},
+    };
+}
+
+bool isEndpoint(int32_t card, int32_t device) {
+    if (card != kCard) return false;
+    for (const auto& endpoint : kEndpoints) {
+        if (endpoint.device == device) return true;
+    }
+    return false;
+}
+
+std::optional<alsa::DeviceProfile> parseDevice(const AudioDevice& device) {
+    if (device.address.getTag() != AudioDeviceAddress::Tag::id) return std::nullopt;
+    const std::string& address = device.address.get<AudioDeviceAddress::Tag::id>();
+    int32_t card = -1;
+    int32_t pcmDevice = -1;
+    int consumed = 0;
+    if (std::sscanf(address.c_str(), "CARD_%d_DEV_%d%n", &card, &pcmDevice, &consumed) != 2 ||
+        consumed != static_cast<int>(address.size()) || !isEndpoint(card, pcmDevice)) {
+        return std::nullopt;
+    }
+    return alsa::DeviceProfile{
+            .card = card,
+            .device = pcmDevice,
+            .direction = PCM_IN,
+            .isExternal = false,
+    };
+}
+
+}  // namespace
+
+std::unique_ptr<Module::Configuration> makeConfiguration() {
+    auto config = std::make_unique<Module::Configuration>();
+    const AudioProfile profile = makeProfile();
+
+    for (const auto& endpoint : kEndpoints) {
+        AudioPort devicePort;
+        devicePort.id = config->nextPortId++;
+        devicePort.name = endpoint.name;
+        devicePort.flags = AudioIoFlags::make<AudioIoFlags::Tag::input>(0);
+        devicePort.profiles = {profile};
+        devicePort.ext = makeDeviceExt(endpoint);
+        config->ports.push_back(devicePort);
+
+        AudioPortConfig deviceConfig;
+        deviceConfig.id = devicePort.id;
+        deviceConfig.portId = devicePort.id;
+        deviceConfig.format = AudioFormatDescription{};
+        deviceConfig.channelMask = AudioChannelLayout{};
+        deviceConfig.sampleRate = Int{.value = 0};
+        deviceConfig.gain = AudioGainConfig{};
+        deviceConfig.flags = devicePort.flags;
+        deviceConfig.ext = devicePort.ext;
+        config->initialConfigs.push_back(deviceConfig);
+
+        AudioPort mixPort;
+        mixPort.id = config->nextPortId++;
+        mixPort.name = std::string(endpoint.name) + " 192k input";
+        // UNPROCESSED is carried as source metadata. Keep the mix flags at
+        // NONE so blocking Java AudioRecord and non-low-latency AAudio can use
+        // the same exact-rate route; FAST/RAW requests are retried without
+        // optional flags by AudioPolicyManager.
+        mixPort.flags = AudioIoFlags::make<AudioIoFlags::Tag::input>(0);
+        mixPort.profiles = {profile};
+        mixPort.ext = makeMixExt();
+        config->ports.push_back(mixPort);
+
+        AudioRoute route;
+        route.sourcePortIds = {devicePort.id};
+        route.sinkPortId = mixPort.id;
+        config->routes.push_back(std::move(route));
+    }
+
+    config->portConfigs = config->initialConfigs;
+    return config;
+}
+
+StreamPowerphone::StreamPowerphone(StreamContext* context, const Metadata& metadata)
+    : StreamAlsa(context, metadata, 1 /* readWriteRetries */) {}
+
+ndk::ScopedAStatus StreamPowerphone::setConnectedDevices(const ConnectedDevices& devices) {
+    if (devices.size() > 1) {
+        LOG(ERROR) << __func__ << ": expected at most one input device, got " << devices.size();
+        return ndk::ScopedAStatus::fromExceptionCode(EX_UNSUPPORTED_OPERATION);
+    }
+
+    std::vector<alsa::DeviceProfile> profiles;
+    if (!devices.empty()) {
+        auto profile = parseDevice(devices.front());
+        if (!profile.has_value()) {
+            LOG(ERROR) << __func__ << ": rejected device " << devices.front().toString();
+            return ndk::ScopedAStatus::fromExceptionCode(EX_ILLEGAL_ARGUMENT);
+        }
+        profiles.push_back(*profile);
+    }
+    RETURN_STATUS_IF_ERROR(StreamCommonImpl::setConnectedDevices(devices));
+    std::lock_guard lock(mLock);
+    mDeviceProfiles = std::move(profiles);
+    return ndk::ScopedAStatus::ok();
+}
+
+std::vector<alsa::DeviceProfile> StreamPowerphone::getDeviceProfiles() {
+    std::lock_guard lock(mLock);
+    return mDeviceProfiles;
+}
+
+StreamInPowerphone::StreamInPowerphone(StreamContext&& context, const SinkMetadata& sinkMetadata,
+                                       const std::vector<MicrophoneInfo>& microphones)
+    : StreamIn(std::move(context), microphones),
+      StreamPowerphone(&mContextInstance, sinkMetadata) {}
+
+ndk::ScopedAStatus ModulePowerphone::createInputStream(
+        StreamContext&& context, const SinkMetadata& sinkMetadata,
+        const std::vector<MicrophoneInfo>& microphones, std::shared_ptr<StreamIn>* result) {
+    return createStreamInstance<StreamInPowerphone>(result, std::move(context), sinkMetadata,
+                                                    microphones);
+}
+
+ndk::ScopedAStatus ModulePowerphone::createOutputStream(
+        StreamContext&& context __unused, const SourceMetadata& sourceMetadata __unused,
+        const std::optional<AudioOffloadInfo>& offloadInfo __unused,
+        std::shared_ptr<StreamOut>* result __unused) {
+    return ndk::ScopedAStatus::fromExceptionCode(EX_UNSUPPORTED_OPERATION);
+}
+
+int32_t ModulePowerphone::getNominalLatencyMs(const AudioPortConfig&) {
+    // 20 ms rounds to a 4096-frame ALSA buffer at 192 kHz. This gives the
+    // research path enough scheduling margin without a global tinyalsa property
+    // that would also alter Google's primary HAL.
+    return 20;
+}
+
+}  // namespace aidl::android::hardware::audio::core::powerphone
