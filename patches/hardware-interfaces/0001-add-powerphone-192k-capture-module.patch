+#pragma once
+
+#include <mutex>
+#include <vector>
+
+#include "core-impl/Module.h"
+#include "core-impl/StreamAlsa.h"
+
+namespace aidl::android::hardware::audio::core::powerphone {
+
+std::unique_ptr<Module::Configuration> makeConfiguration();
+
+class StreamPowerphone : public StreamAlsa {
+  public:
+    StreamPowerphone(StreamContext* context, const Metadata& metadata);
+
+    ndk::ScopedAStatus setConnectedDevices(const ConnectedDevices& devices) override;
+
+  protected:
+    std::vector<alsa::DeviceProfile> getDeviceProfiles() override;
+
+  private:
+    std::mutex mLock;
+    std::vector<alsa::DeviceProfile> mDeviceProfiles GUARDED_BY(mLock);
+};
+
+class StreamInPowerphone final : public StreamIn, public StreamPowerphone {
+  public:
+    friend class ndk::SharedRefBase;
+    StreamInPowerphone(
+            StreamContext&& context,
+            const ::aidl::android::hardware::audio::common::SinkMetadata& sinkMetadata,
+            const std::vector<::aidl::android::media::audio::common::MicrophoneInfo>& microphones);
+
+  private:
+    void onClose(StreamDescriptor::State) override { defaultOnClose(); }
+};
+
+class ModulePowerphone final : public Module {
+  public:
+    explicit ModulePowerphone(std::unique_ptr<Configuration>&& config)
+        : Module(Type::DEFAULT, std::move(config)) {}
+
+  protected:
+    ndk::ScopedAStatus createInputStream(
+            StreamContext&& context,
+            const ::aidl::android::hardware::audio::common::SinkMetadata& sinkMetadata,
+            const std::vector<::aidl::android::media::audio::common::MicrophoneInfo>& microphones,
+            std::shared_ptr<StreamIn>* result) override;
+    ndk::ScopedAStatus createOutputStream(
+            StreamContext&& context,
+            const ::aidl::android::hardware::audio::common::SourceMetadata& sourceMetadata,
+            const std::optional<::aidl::android::media::audio::common::AudioOffloadInfo>& offloadInfo,
+            std::shared_ptr<StreamOut>* result) override;
+    int32_t getNominalLatencyMs(
+            const ::aidl::android::media::audio::common::AudioPortConfig& portConfig) override;
+};
+
+}  // namespace aidl::android::hardware::audio::core::powerphone
diff --git a/audio/aidl/default/powerphone/Powerphone.cpp b/audio/aidl/default/powerphone/Powerphone.cpp
