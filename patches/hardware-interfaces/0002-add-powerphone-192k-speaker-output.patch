+::android::status_t StreamPowerphone::start() {
+  if (mIsInput) {
+    if (!::android::base::GetBoolProperty(kCaptureReadyProperty, false)) {
+      LOG(ERROR) << __func__ << ": " << kCaptureReadyProperty
+                 << " is absent or false; the PDM data path is not certified";
+      StreamAlsa::standby();
+      return ::android::PERMISSION_DENIED;
+    }
+    return StreamAlsa::start();
+  }
+
+  bool resumedRoute = false;
+  bool resumedReady = false;
+  bool resumedOwnership = false;
+  {
+    std::lock_guard lock(mLock);
+    if (mPlaybackRoute != nullptr) {
+      // Resume after pause; the PCM proxy and owned route remain active.
+      resumedRoute = true;
+      resumedReady =
+          ::android::base::GetBoolProperty(kSpeakerReadyProperty, false);
+      resumedOwnership = mPlaybackRoute->verifyOwnership();
+    } else if (!mPlaybackEndpoint.has_value() || mDeviceProfiles.size() != 1) {
+      LOG(ERROR) << __func__ << ": no unique PowerPhone output is connected";
+      return ::android::NO_INIT;
+    } else if (!::android::base::GetBoolProperty(kSpeakerReadyProperty,
+                                                 false)) {
+      LOG(ERROR) << __func__ << ": " << kSpeakerReadyProperty
+                 << " is absent or false; volatile AoC patch is not certified";
+      return ::android::PERMISSION_DENIED;
+    } else if (!acquirePlaybackLease(this)) {
+      LOG(ERROR) << __func__
+                 << ": PCM 0,28 is already owned by another sidecar stream";
+      return ::android::WOULD_BLOCK;
+    } else {
+      mOwnsPlaybackLease = true;
+      mPlaybackRoute = std::make_unique<PlaybackRoute>();
+      if (!mPlaybackRoute->configure(*mPlaybackEndpoint)) {
+        cleanupPlaybackRouteLocked();
+        return ::android::INVALID_OPERATION;
+      }
+    }
+  }
+
+  if (resumedRoute) {
+    if (resumedReady && resumedOwnership)
+      return ::android::OK;
+    LOG(ERROR) << __func__ << ": refusing speaker resume: "
+               << (resumedReady ? "mixer ownership lost" : "readiness revoked");
+    StreamAlsa::standby();
+    std::lock_guard lock(mLock);
+    cleanupPlaybackRouteLocked();
+    return resumedReady ? ::android::INVALID_OPERATION
+                        : ::android::PERMISSION_DENIED;
+  }
+
+  const ::android::status_t status = StreamAlsa::start();
+  if (status != ::android::OK || mAlsaDeviceProxies.size() != 1) {
+    StreamAlsa::standby();
+    std::lock_guard lock(mLock);
+    cleanupPlaybackRouteLocked();
+    return status == ::android::OK ? ::android::NO_INIT : status;
+  }
+  const bool ready =
+      ::android::base::GetBoolProperty(kSpeakerReadyProperty, false);
+  bool ownsRoute = false;
+  {
+    std::lock_guard lock(mLock);
+    ownsRoute = mPlaybackRoute != nullptr && mPlaybackRoute->verifyOwnership();
+  }
+  if (!ready || !ownsRoute) {
+    LOG(ERROR) << __func__ << ": speaker state changed while opening PCM: "
+               << (ready ? "mixer ownership lost" : "readiness revoked");
+    StreamAlsa::standby();
+    std::lock_guard lock(mLock);
+    cleanupPlaybackRouteLocked();
+    return ready ? ::android::INVALID_OPERATION : ::android::PERMISSION_DENIED;
+  }
+  return ::android::OK;
+}
