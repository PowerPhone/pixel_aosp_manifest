+::android::status_t StreamPowerphone::transfer(void *buffer, size_t frameCount,
+                                               size_t *actualFrameCount,
+                                               int32_t *latencyMs) {
+  if (mIsInput) {
+    if (!::android::base::GetBoolProperty(kCaptureReadyProperty, false)) {
+      LOG(ERROR) << __func__ << ": " << kCaptureReadyProperty
+                 << " was revoked; closing capture PCM";
+      StreamAlsa::standby();
+      *actualFrameCount = 0;
+      return ::android::PERMISSION_DENIED;
+    }
+    return StreamAlsa::transfer(buffer, frameCount, actualFrameCount,
+                                latencyMs);
+  }
+  if (mAlsaDeviceProxies.size() != 1 ||
+      mAlsaDeviceProxies.front().get() == nullptr) {
+    LOG(ERROR) << __func__ << ": no unique opened playback device";
+    return ::android::NO_INIT;
+  }
+
+  const size_t bytesToTransfer = frameCount * mFrameSizeBytes;
+  alsa::applyGain(buffer, mGain, bytesToTransfer, mConfig.value().format,
+                  mConfig->channels);
+  const size_t periodFrames = std::max<size_t>(
+      1, proxy_get_period_size(mAlsaDeviceProxies.front().get()));
+  size_t transferredFrames = 0;
+  while (transferredFrames < frameCount) {
+    const bool ready =
+        ::android::base::GetBoolProperty(kSpeakerReadyProperty, false);
+    bool ownsRoute = false;
+    {
+      std::lock_guard lock(mLock);
+      ownsRoute =
+          mPlaybackRoute != nullptr && mPlaybackRoute->verifyOwnership();
+    }
+    if (!ready || !ownsRoute) {
+      LOG(ERROR) << __func__ << ": aborting before the next ALSA period: "
+                 << (ready ? "mixer ownership lost"
+                           : "speaker readiness revoked");
+      StreamAlsa::standby();
+      {
+        std::lock_guard lock(mLock);
+        cleanupPlaybackRouteLocked();
+      }
+      *actualFrameCount = transferredFrames;
+      return ready ? ::android::INVALID_OPERATION
+                   : ::android::PERMISSION_DENIED;
+    }
+    const size_t chunkFrames =
+        std::min(periodFrames, frameCount - transferredFrames);
+    const size_t chunkBytes = chunkFrames * mFrameSizeBytes;
+    auto *chunk =
+        static_cast<uint8_t *>(buffer) + transferredFrames * mFrameSizeBytes;
+    if (chunkBytes > std::numeric_limits<unsigned int>::max() ||
+        proxy_write_with_retries(mAlsaDeviceProxies.front().get(), chunk,
+                                 static_cast<unsigned int>(chunkBytes),
+                                 mReadWriteRetries) != 0) {
+      LOG(ERROR) << __func__ << ": period-sized PCM write failed after "
+                 << transferredFrames << " frames";
+      StreamAlsa::standby();
+      {
+        std::lock_guard lock(mLock);
+        cleanupPlaybackRouteLocked();
+      }
+      *actualFrameCount = transferredFrames;
+      return ::android::INVALID_OPERATION;
+    }
+    transferredFrames += chunkFrames;
+  }
+  *actualFrameCount = transferredFrames;
+  const unsigned latency = proxy_get_latency(mAlsaDeviceProxies.front().get());
+  *latencyMs = static_cast<int32_t>(std::min(
+      latency, static_cast<unsigned>(std::numeric_limits<int32_t>::max())));
+  return ::android::OK;
 }
 
