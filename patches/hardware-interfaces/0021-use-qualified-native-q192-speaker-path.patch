-     * Keep all software thresholds at zero.  This is the exact legacy
-     * tinyplay contract: for a blocking playback PCM, libtinyalsa v1 resolves
-     * them to half-buffer start, full-buffer stop, zero silence, and an
+     * Frankel's native-q192 system path is qualified with an explicit
+     * one-period start. Keep the remaining software fields at zero so
+     * libtinyalsa v1 resolves them to full-buffer stop, zero silence, and an
      * avail_min of one frame.
      */
 
@@ -138,12 +153,58 @@ int powerphone_legacy_pcm_get_xruns(struct powerphone_legacy_pcm* pcm) {
     return pcm == NULL ? -EINVAL : pcm_get_xruns(unwrap(pcm));
 }
 
-int powerphone_legacy_pcm_write(struct powerphone_legacy_pcm* pcm, const void* data,
-                                uint32_t byte_count) {
-    if (pcm == NULL || data == NULL) {
+int powerphone_legacy_pcm_prepare(struct powerphone_legacy_pcm* pcm) {
+    return pcm == NULL ? -EINVAL : pcm_prepare(unwrap(pcm));
+}
+
+int powerphone_legacy_pcm_writei_frames(struct powerphone_legacy_pcm* pcm,
+                                        const void* data, uint32_t frame_count,
+                                        uint32_t max_efault_retries,
+                                        uint32_t efault_retry_sleep_us,
+                                        uint32_t* actual_efault_retries) {
+    uint32_t retries = 0;
+
+    if (actual_efault_retries != NULL) {
+        *actual_efault_retries = 0;
+    }
+    if (pcm == NULL || data == NULL || frame_count == 0) {
         return -EINVAL;
     }
-    return pcm_write(unwrap(pcm), data, byte_count);
+
+    const int fd = pcm_get_poll_fd(unwrap(pcm));
+    if (fd < 0) {
+        return fd;
+    }
+    for (;;) {
+        struct snd_xferi transfer_request;
+        int write_result;
+        int write_errno;
+
+        memset(&transfer_request, 0, sizeof(transfer_request));
+        transfer_request.buf = (void*)data;
+        transfer_request.frames = frame_count;
+        errno = 0;
+        write_result = powerphone_legacy_writei_ioctl(fd, &transfer_request);
+        write_errno = errno;
+        if (write_result == 0) {
+            if (actual_efault_retries != NULL) {
+                *actual_efault_retries = retries;
+            }
+            return 0;
+        }
+        if ((write_errno != EFAULT && write_result != -EFAULT) ||
+            retries >= max_efault_retries) {
+            if (actual_efault_retries != NULL) {
+                *actual_efault_retries = retries;
+            }
+            return write_errno != 0 ? -write_errno
+                                    : (write_result < 0 ? write_result : -EIO);
+        }
+        ++retries;
+        if (efault_retry_sleep_us != 0) {
+            usleep(efault_retry_sleep_us);
+        }
+    }
 }
 
