+#include <errno.h>
+#include <stddef.h>
+#include <string.h>
+
+#include <powerphone/PlaybackRouteVolume.h>
+
+static const char kEarpieceDigitalPcmVolume[] = "Digital PCM Volume";
+static const char kBottomDigitalPcmVolume[] = "R Digital PCM Volume";
+
+static int validate(const struct powerphone_playback_volume_state* state,
+                    const struct powerphone_playback_volume_ops* ops) {
+    return state != NULL && ops != NULL && ops->get != NULL && ops->set != NULL;
+}
+
+void powerphone_playback_volume_reset(struct powerphone_playback_volume_state* state) {
+    if (state != NULL) {
+        memset(state, 0, sizeof(*state));
+    }
+}
+
+int powerphone_playback_volume_configure(
+        struct powerphone_playback_volume_state* state,
+        enum powerphone_playback_volume_endpoint endpoint,
+        const struct powerphone_playback_volume_ops* ops) {
+    int32_t actual;
+    int status;
+
+    if (!validate(state, ops)) return -EINVAL;
+    powerphone_playback_volume_reset(state);
+    switch (endpoint) {
+        case POWERPHONE_PLAYBACK_VOLUME_EARPIECE:
+            state->control_name = kEarpieceDigitalPcmVolume;
+            break;
+        case POWERPHONE_PLAYBACK_VOLUME_BOTTOM:
+            state->control_name = kBottomDigitalPcmVolume;
+            break;
+        default:
+            return -EINVAL;
+    }
+    status = ops->get(ops->context, state->control_name, &state->saved_value);
+    if (status != 0) {
+        powerphone_playback_volume_reset(state);
+        return status;
+    }
+    /* A failed write may still have touched hardware, so retain the snapshot. */
+    state->restore_required = 1;
+    status = ops->set(ops->context, state->control_name,
+                      POWERPHONE_PLAYBACK_DIGITAL_PCM_VOLUME);
+    if (status != 0) return status;
+    status = ops->get(ops->context, state->control_name, &actual);
+    if (status != 0) return status;
+    return actual == POWERPHONE_PLAYBACK_DIGITAL_PCM_VOLUME ? 0 : -EIO;
+}
+
+int powerphone_playback_volume_verify(
+        const struct powerphone_playback_volume_state* state,
+        const struct powerphone_playback_volume_ops* ops) {
+    int32_t actual;
+    int status;
+
+    if (!validate(state, ops) || state->restore_required == 0 ||
+        state->control_name == NULL) {
+        return -EINVAL;
+    }
+    status = ops->get(ops->context, state->control_name, &actual);
+    if (status != 0) return status;
+    return actual == POWERPHONE_PLAYBACK_DIGITAL_PCM_VOLUME ? 0 : -EIO;
+}
+
+int powerphone_playback_volume_restore(
+        struct powerphone_playback_volume_state* state, int hard_off_proved,
+        const struct powerphone_playback_volume_ops* ops) {
+    int32_t actual;
+    int status;
+
+    if (!validate(state, ops)) return -EINVAL;
+    if (state->restore_required == 0) return 0;
+    if (state->control_name == NULL) return -EINVAL;
+    if (!hard_off_proved) return -EPERM;
+    status = ops->set(ops->context, state->control_name, state->saved_value);
+    if (status != 0) return status;
+    status = ops->get(ops->context, state->control_name, &actual);
+    if (status != 0) return status;
+    if (actual != state->saved_value) return -EIO;
+    powerphone_playback_volume_reset(state);
+    return 0;
+}
