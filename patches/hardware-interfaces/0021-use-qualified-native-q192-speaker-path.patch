+extern "C" int powerphone_legacy_writei_ioctl(int fd, struct snd_xferi* transfer) {
+    EXPECT_EQ(gPcm.pollFd, fd);
+    if (transfer == nullptr) {
+        ADD_FAILURE() << "WRITEI ioctl received a null transfer";
+        errno = EINVAL;
+        return -1;
+    }
+    gWriteBuffers.push_back(transfer->buf);
+    gWriteFrames.push_back(transfer->frames);
+    if (gNextIoctlResult >= gIoctlResults.size()) {
+        ADD_FAILURE() << "unexpected WRITEI ioctl";
+        errno = EIO;
+        return -1;
+    }
+    const FakeIoctlResult result = gIoctlResults[gNextIoctlResult++];
+    errno = result.error;
+    return result.status;
+}

