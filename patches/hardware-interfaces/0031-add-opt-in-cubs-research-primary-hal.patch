+/* Copyright (C) 2026 The Android Open Source Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+#pragma once
+
+#include <array>
+#include <optional>
+#include <aidl/android/hardware/audio/core/BnConfig.h>
+#include <aidl/android/hardware/audio/effect/BnFactory.h>
+
+namespace aidl::android::hardware::audio::core::powerphone {
+
+// An owned, deliberately unprocessed research image. This is a complete empty
+// effects factory, not a missing service which would strand framework lookup.
+class CubsEmptyEffects final : public ::aidl::android::hardware::audio::effect::BnFactory {
+    using Uuid = ::aidl::android::media::audio::common::AudioUuid;
+    using Descriptor = ::aidl::android::hardware::audio::effect::Descriptor;
+    using Processing = ::aidl::android::hardware::audio::effect::Processing;
+    using IEffect = ::aidl::android::hardware::audio::effect::IEffect;
+  public:
+    ndk::ScopedAStatus queryEffects(const std::optional<Uuid>&, const std::optional<Uuid>&,
+                                   const std::optional<Uuid>&,
+                                   std::vector<Descriptor>* result) override {
+        result->clear();
+        return ndk::ScopedAStatus::ok();
+    }
+    ndk::ScopedAStatus queryProcessing(const std::optional<Processing::Type>&,
+                                      std::vector<Processing>* result) override {
+        result->clear();
+        return ndk::ScopedAStatus::ok();
+    }
+    ndk::ScopedAStatus createEffect(const Uuid&, std::shared_ptr<IEffect>* result) override {
+        result->reset();
+        return ndk::ScopedAStatus::fromExceptionCode(EX_ILLEGAL_ARGUMENT);
+    }
+    ndk::ScopedAStatus destroyEffect(const std::shared_ptr<IEffect>&) override {
+        return ndk::ScopedAStatus::fromExceptionCode(EX_ILLEGAL_ARGUMENT);
+    }
+};
+
+class CubsConfig final : public BnConfig {
+  public:
+    ndk::ScopedAStatus getSurroundSoundConfig(SurroundSoundConfig* result) override {
+        *result = {};
+        return ndk::ScopedAStatus::ok();
+    }
+    ndk::ScopedAStatus getEngineConfig(
+            ::aidl::android::media::audio::common::AudioHalEngineConfig* result) override {
+        using Group = ::aidl::android::media::audio::common::AudioHalVolumeGroup;
+        using Curve = ::aidl::android::media::audio::common::AudioHalVolumeCurve;
+        *result = {};
+        // Empty strategies intentionally select AOSP's standard policy engine.
+        // Nonempty volume groups are mandatory. These conservative research
+        // curves are owned here, not imported from a proprietary CAP config.
+        const std::array<std::pair<const char*, int>, 14> streams{{
+                {"VOICE_CALL", 5}, {"SYSTEM", 7}, {"RING", 7}, {"MUSIC", 25},
+                {"ALARM", 7}, {"NOTIFICATION", 7}, {"BLUETOOTH_SCO", 15},
+                {"ENFORCED_AUDIBLE", 7}, {"DTMF", 15}, {"TTS", 15},
+                {"ACCESSIBILITY", 15}, {"ASSISTANT", 15},
+                {"REROUTING", 100}, {"PATCH", 100}}};
+        for (const auto& [name, maximum] : streams) {
+            Group group;
+            group.name = std::string("AUDIO_STREAM_") + name;
+            group.minIndex = 0;
+            group.maxIndex = maximum;
+            for (int category = 0; category <= 4; ++category) {
+                Curve curve;
+                curve.deviceCategory = static_cast<Curve::DeviceCategory>(category);
+                for (const auto [index, gain] :
+                     std::array<std::pair<int8_t, int>, 5>{{
+                             {0, -9600}, {1, -6000}, {33, -4000}, {66, -2000}, {100, 0}}}) {
+                    Curve::CurvePoint point;
+                    point.index = index;
+                    point.attenuationMb = gain;
+                    curve.curvePoints.push_back(point);
+                }
+                group.volumeCurves.push_back(std::move(curve));
+            }
+            result->volumeGroups.push_back(std::move(group));
+        }
+        return ndk::ScopedAStatus::ok();
+    }
+};
+
+}  // namespace aidl::android::hardware::audio::core::powerphone
