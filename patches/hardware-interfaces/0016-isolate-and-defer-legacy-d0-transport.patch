+
+#pragma once
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/*
+ * The old and new tinyalsa libraries intentionally expose many identically
+ * named C symbols, but their private PCM objects and public pcm_config layouts
+ * are not ABI-compatible.  This interface is therefore scalar-only and keeps
+ * the legacy handle opaque.  No tinyalsa type may cross this boundary.
+ */
+struct powerphone_legacy_pcm;
+
+#define POWERPHONE_LEGACY_PCM_FORMAT_S16_LE 0u
+#define POWERPHONE_LEGACY_PCM_FORMAT_S32_LE 1u
+
+struct powerphone_legacy_pcm_open_result {
+    uint32_t period_size_frames;
+    uint32_t period_count;
+    uint32_t buffer_size_frames;
+};
+
+/*
+ * Opens a blocking RW-interleaved playback PCM with PCM_OUT only.  The
+ * start/stop/silence/avail-min fields use legacy tinyplay's zero defaults.
+ * Like legacy pcm_open(), a non-null return can still describe a failed open;
+ * callers must check powerphone_legacy_pcm_is_ready() before using it.
+ */
+struct powerphone_legacy_pcm* powerphone_legacy_pcm_open_playback(
+        uint32_t card, uint32_t device, uint32_t channels, uint32_t rate,
+        uint32_t period_size_frames, uint32_t period_count, uint32_t format,
+        struct powerphone_legacy_pcm_open_result* result);
+
+int powerphone_legacy_pcm_is_ready(struct powerphone_legacy_pcm* pcm);
+const char* powerphone_legacy_pcm_get_error(struct powerphone_legacy_pcm* pcm);
+uint32_t powerphone_legacy_pcm_get_buffer_size(struct powerphone_legacy_pcm* pcm);
+int powerphone_legacy_pcm_get_xruns(struct powerphone_legacy_pcm* pcm);
+
+/* Byte-oriented, blocking legacy pcm_write() semantics. */
+int powerphone_legacy_pcm_write(struct powerphone_legacy_pcm* pcm, const void* data,
+                                uint32_t byte_count);
+int powerphone_legacy_pcm_stop(struct powerphone_legacy_pcm* pcm);
+int powerphone_legacy_pcm_close(struct powerphone_legacy_pcm* pcm);
+
+#ifdef __cplusplus
+} /* extern "C" */
+#endif
