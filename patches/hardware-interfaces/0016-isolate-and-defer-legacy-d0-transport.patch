+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#include <errno.h>
+#include <limits.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+#include <powerphone/LegacyTinyalsaV1.h>
+#include <tinyalsa/asoundlib.h>
+
+/* This facade is built only for Android targets where these ABI facts hold. */
+_Static_assert(sizeof(unsigned int) == sizeof(uint32_t), "unexpected unsigned-int ABI");
+_Static_assert(sizeof(int) == sizeof(int32_t), "unexpected int ABI");
+_Static_assert(sizeof(enum pcm_format) == sizeof(int32_t), "unexpected legacy enum ABI");
+_Static_assert(sizeof(struct pcm_config) == 10 * sizeof(uint32_t),
+               "unexpected legacy pcm_config ABI");
+_Static_assert(sizeof(struct powerphone_legacy_pcm_open_result) == 3 * sizeof(uint32_t),
+               "unexpected PowerPhone facade ABI");
+_Static_assert(PCM_OUT == 0, "unexpected legacy PCM_OUT value");
+_Static_assert((uint32_t)PCM_FORMAT_S16_LE == POWERPHONE_LEGACY_PCM_FORMAT_S16_LE,
+               "unexpected legacy S16 format value");
+_Static_assert((uint32_t)PCM_FORMAT_S32_LE == POWERPHONE_LEGACY_PCM_FORMAT_S32_LE,
+               "unexpected legacy S32 format value");
+
+static struct pcm* unwrap(struct powerphone_legacy_pcm* pcm) {
+    return (struct pcm*)pcm;
+}
+
+struct powerphone_legacy_pcm* powerphone_legacy_pcm_open_playback(
+        uint32_t card, uint32_t device, uint32_t channels, uint32_t rate,
+        uint32_t period_size_frames, uint32_t period_count, uint32_t format,
+        struct powerphone_legacy_pcm_open_result* result) {
+    struct pcm_config config;
+    enum pcm_format legacy_format;
+    struct pcm* pcm;
+
+    if (result != NULL) {
+        memset(result, 0, sizeof(*result));
+    }
+    if (channels == 0 || rate == 0 || period_size_frames == 0 || period_count == 0) {
+        errno = EINVAL;
+        return NULL;
+    }
+    switch (format) {
+        case POWERPHONE_LEGACY_PCM_FORMAT_S16_LE:
+            legacy_format = PCM_FORMAT_S16_LE;
+            break;
+        case POWERPHONE_LEGACY_PCM_FORMAT_S32_LE:
+            legacy_format = PCM_FORMAT_S32_LE;
+            break;
+        default:
+            errno = EINVAL;
+            return NULL;
+    }
+
+    memset(&config, 0, sizeof(config));
+    config.channels = channels;
+    config.rate = rate;
+    config.period_size = period_size_frames;
+    config.period_count = period_count;
+    config.format = legacy_format;
+    /*
+     * Keep all software thresholds at zero.  This is the exact legacy
+     * tinyplay contract: for a blocking playback PCM, libtinyalsa v1 resolves
+     * them to half-buffer start, full-buffer stop, zero silence, and an
+     * avail_min of one frame.
+     */
+
+    pcm = pcm_open(card, device, PCM_OUT, &config);
+    if (pcm != NULL && pcm_is_ready(pcm) && result != NULL) {
+        result->period_size_frames = config.period_size;
+        result->period_count = config.period_count;
+        result->buffer_size_frames = pcm_get_buffer_size(pcm);
+    }
+    return (struct powerphone_legacy_pcm*)pcm;
+}
+
+int powerphone_legacy_pcm_is_ready(struct powerphone_legacy_pcm* pcm) {
+    return pcm != NULL && pcm_is_ready(unwrap(pcm));
+}
+
+const char* powerphone_legacy_pcm_get_error(struct powerphone_legacy_pcm* pcm) {
+    return pcm == NULL ? "legacy PCM handle is null" : pcm_get_error(unwrap(pcm));
+}
+
+uint32_t powerphone_legacy_pcm_get_buffer_size(struct powerphone_legacy_pcm* pcm) {
+    return pcm == NULL ? 0 : pcm_get_buffer_size(unwrap(pcm));
+}
+
+int powerphone_legacy_pcm_get_xruns(struct powerphone_legacy_pcm* pcm) {
+    return pcm == NULL ? -EINVAL : pcm_get_xruns(unwrap(pcm));
+}
+
+int powerphone_legacy_pcm_write(struct powerphone_legacy_pcm* pcm, const void* data,
+                                uint32_t byte_count) {
+    if (pcm == NULL || data == NULL) {
+        return -EINVAL;
+    }
+    return pcm_write(unwrap(pcm), data, byte_count);
+}
+
+int powerphone_legacy_pcm_stop(struct powerphone_legacy_pcm* pcm) {
+    return pcm == NULL ? -EINVAL : pcm_stop(unwrap(pcm));
+}
+
+int powerphone_legacy_pcm_close(struct powerphone_legacy_pcm* pcm) {
+    return pcm == NULL ? 0 : pcm_close(unwrap(pcm));
+}
