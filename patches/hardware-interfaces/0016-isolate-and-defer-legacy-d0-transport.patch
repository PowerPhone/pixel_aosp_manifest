+::android::status_t StreamPowerphone::drain(StreamDescriptor::DrainMode mode) {
+    if (mIsInput) return StreamAlsaBase::drain(mode);
+    powerphone_legacy_pcm* playbackPcm = nullptr;
+    {
+        std::lock_guard lock(mLock);
+        playbackPcm = mLegacyPlaybackPcm;
+    }
+    if (playbackPcm == nullptr || !powerphone_legacy_pcm_is_ready(playbackPcm)) {
+        LOG(ERROR) << __func__ << ": no opened legacy playback device";
+        return ::android::NO_INIT;
+    }
+
+    const int expectedXruns = mPlaybackXrunsBaseline.load(std::memory_order_acquire);
+    const int xrunsBefore = powerphone_legacy_pcm_get_xruns(playbackPcm);
+    if (xrunsBefore != expectedXruns) {
+        LOG(ERROR) << __func__ << ": refusing drain after an integrity failure: xruns="
+                   << xrunsBefore << " (expected " << expectedXruns << "), pcm_error="
+                   << powerphone_legacy_pcm_get_error(playbackPcm);
+        standby();
+        return ::android::INVALID_OPERATION;
+    }
+
+    // Legacy tinyplay has no pcm_drain operation. It waits exactly one ALSA
+    // ring before close; do the same without inserting a new AoC-facing ioctl.
+    usleep(static_cast<useconds_t>(kPlaybackLatencyMs * 1000));
+    const int xrunsAfter = powerphone_legacy_pcm_get_xruns(playbackPcm);
+    if (xrunsAfter != expectedXruns) {
+        LOG(ERROR) << __func__ << ": playback integrity failed while draining: xruns="
+                   << xrunsBefore << "->" << xrunsAfter << ", pcm_error="
+                   << powerphone_legacy_pcm_get_error(playbackPcm);
+        standby();
+        return ::android::INVALID_OPERATION;
+    }
+    return ::android::OK;
+}
