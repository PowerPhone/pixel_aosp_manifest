From fe9b2060daf13ddb6fd907321b033c1436a87613 Mon Sep 17 00:00:00 2001
From: Pixel AOSP maintainers <pixel-aosp@example.invalid>
Date: Fri, 28 Aug 2026 15:10:00 -0400
Subject: [PATCH] Propagate deterministic DTBO salt to target files

The fsgen DTBO module signs its direct image with a deterministic salt derived
from the build number and date, but its misc_info fragment records only the
fingerprint property. Releasetools consequently reconstructs different DTBO
bytes and breaks the Soong migration diff graph.

Generate the existing salt expression once, consume that file for direct
signing, and expose the same contents to target-files reconstruction. Add a
focused fixture test binding both consumers to the generated salt.

This is a project-authored reproducibility fix for android-17.0.0_r1.
License: Apache-2.0 (platform/build/soong)
---
 filesystem/dtboimg.go         | 41 ++++++++++++++++++++++++++---------
 filesystem/filesystem_test.go | 50 +++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 81 insertions(+), 10 deletions(-)

diff --git a/filesystem/dtboimg.go b/filesystem/dtboimg.go
index e64150132d..550b7ebcc4 100644
--- a/filesystem/dtboimg.go
+++ b/filesystem/dtboimg.go
@@ -55,13 +55,14 @@ var DtboImgInfoProvider = blueprint.NewProvider[DtboImgInfo]()
 
 func (p *prebuiltDtboImg) GenerateAndroidBuildActions(ctx android.ModuleContext) {
 	input := android.PathForModuleSrc(ctx, proptools.String(p.properties.Src))
-	output := p.avbAddHash(ctx, input)
+	saltFile := p.buildAvbSalt(ctx)
+	output := p.avbAddHash(ctx, input, saltFile)
 	ctx.SetOutputFiles(android.Paths{output}, "")
 	android.SetProvider(
 		ctx,
 		DtboImgInfoProvider,
 		DtboImgInfo{
-			PropFileForMiscInfo: p.buildPropFileForMiscInfo(ctx),
+			PropFileForMiscInfo: p.buildPropFileForMiscInfo(ctx, saltFile),
 		},
 	)
 	android.SetProvider(ctx, vbmetaPartitionProvider, vbmetaPartitionInfo{
@@ -70,7 +71,24 @@ func (p *prebuiltDtboImg) GenerateAndroidBuildActions(ctx android.ModuleContext)
 	})
 }
 
-func (p *prebuiltDtboImg) avbAddHash(ctx android.ModuleContext, input android.Path) android.Path {
+func (p *prebuiltDtboImg) buildAvbSalt(ctx android.ModuleContext) android.Path {
+	buildNumberFile := ctx.Config().BuildNumberFile(ctx)
+	buildDateFile := ctx.Config().BuildDateFile(ctx)
+	saltFile := android.PathForModuleOut(ctx, "avb_salt")
+
+	builder := android.NewRuleBuilder(pctx, ctx).SandboxDisabled()
+	builder.Command().
+		Text("sha256sum").
+		Input(buildNumberFile).
+		Input(buildDateFile).
+		Text(`| cut -d " " -f 1 | tr -d '\n'`).
+		FlagWithOutput("> ", saltFile)
+	builder.Build("avb_salt", "avb_salt")
+
+	return saltFile
+}
+
+func (p *prebuiltDtboImg) avbAddHash(ctx android.ModuleContext, input android.Path, saltFile android.Path) android.Path {
 	if p.properties.Use_avb != nil && !*p.properties.Use_avb {
 		// Do not sign if Use_avb is explicitly turned off.
 		return input
@@ -86,7 +104,8 @@ func (p *prebuiltDtboImg) avbAddHash(ctx android.ModuleContext, input android.Pa
 		Text("add_hash_footer").
 		FlagWithArg("--image ", output.String()).
 		Flag("--partition_name dtbo").
-		Textf(`--salt $(sha256sum "%s" "%s" | cut -d " " -f 1 | tr -d '\n')`, ctx.Config().BuildNumberFile(ctx), ctx.Config().Getenv("BUILD_DATETIME_FILE"))
+		Textf(`--salt $(cat "%s")`, saltFile.String()).
+		Implicit(saltFile)
 
 	if p.properties.Partition_size == nil {
 		cmd.Flag("--dynamic_partition_size")
@@ -101,7 +120,7 @@ func (p *prebuiltDtboImg) avbAddHash(ctx android.ModuleContext, input android.Pa
 	return output
 }
 
-func (p *prebuiltDtboImg) buildPropFileForMiscInfo(ctx android.ModuleContext) android.Path {
+func (p *prebuiltDtboImg) buildPropFileForMiscInfo(ctx android.ModuleContext, saltFile android.Path) android.Path {
 	var sb strings.Builder
 	addStr := func(name string, value string) {
 		fmt.Fprintf(&sb, "%s=%s\n", name, value)
@@ -112,16 +131,18 @@ func (p *prebuiltDtboImg) buildPropFileForMiscInfo(ctx android.ModuleContext) an
 		addStr("dtbo_size", strconv.FormatInt(*p.properties.Partition_size, 10))
 	}
 	fingerprintFile := ctx.Config().BuildFingerprintFile(ctx)
-	addStr("avb_dtbo_add_hash_footer_args", "--prop "+fmt.Sprintf("com.android.build.dtbo.fingerprint:{CONTENTS_OF:%s}", fingerprintFile.String()))
+	addStr("avb_dtbo_add_hash_footer_args", fmt.Sprintf(
+		"--salt {CONTENTS_OF:%s} --prop com.android.build.dtbo.fingerprint:{CONTENTS_OF:%s}",
+		saltFile.String(), fingerprintFile.String()))
 
 	propFilePreProcessing := android.PathForModuleOut(ctx, "prop_for_misc_info_pre_processing")
 	android.WriteFileRuleVerbatim(ctx, propFilePreProcessing, sb.String())
 	propFile := android.PathForModuleOut(ctx, "prop_file_for_misc_info")
 	ctx.Build(pctx, android.BuildParams{
-		Rule:     textFileProcessorRule,
-		Input:    propFilePreProcessing,
-		Output:   propFile,
-		Implicit: fingerprintFile,
+		Rule:      textFileProcessorRule,
+		Input:     propFilePreProcessing,
+		Output:    propFile,
+		Implicits: android.Paths{saltFile, fingerprintFile},
 	})
 
 	return propFile
diff --git a/filesystem/filesystem_test.go b/filesystem/filesystem_test.go
index 596d1313f2..844721e4d0 100644
--- a/filesystem/filesystem_test.go
+++ b/filesystem/filesystem_test.go
@@ -297,6 +297,56 @@ func TestAvbAddHashFooter(t *testing.T) {
 		cmd, "--include_descriptors_from_image ")
 }
 
+func TestPrebuiltDtboDeterministicSaltInImageAndMiscInfo(t *testing.T) {
+	t.Parallel()
+	result := android.GroupFixturePreparers(
+		fixture,
+		android.FixtureModifyProductVariables(func(variables android.FixtureProductVariables) {
+			variables.BuildNumberFile = proptools.StringPtr("build_number.txt")
+			variables.BuildFingerprintFile = proptools.StringPtr("build_fingerprint.txt")
+		}),
+		android.FixtureRegisterWithContext(func(ctx android.RegistrationContext) {
+			ctx.RegisterModuleType("prebuilt_dtbo_image", PrebuiltDtboImgFactory)
+		}),
+		android.FixtureMergeMockFs(android.MockFS{
+			"dtbo.img": nil,
+		}),
+	).RunTestWithBp(t, `
+		prebuilt_dtbo_image {
+			name: "mydtbo",
+			src: "dtbo.img",
+			partition_size: 16777216,
+		}
+	`)
+
+	module := result.ModuleForTests(t, "mydtbo", "android_arm64_armv8-a")
+	saltRule := module.Rule("avb_salt")
+	saltOutput := saltRule.Output.String()
+	android.AssertStringDoesContain(t, "salt must use the build number",
+		saltRule.RuleParams.Command, "build_number.txt")
+	android.AssertStringDoesContain(t, "salt must use the build date",
+		saltRule.RuleParams.Command, "build_date.txt")
+	android.AssertStringDoesContain(t, "salt pipeline changed",
+		saltRule.RuleParams.Command, `| cut -d " " -f 1 | tr -d '\n'`)
+
+	imageCommand := module.Rule("add_hash_footer").RuleParams.Command
+	android.AssertStringDoesContain(t, "direct DTBO signing must consume the generated salt",
+		imageCommand, `--salt $$(cat "`+saltOutput+`")`)
+
+	miscInfoSource := android.ContentFromFileRuleForTests(t, result.TestContext,
+		module.Output("prop_for_misc_info_pre_processing"))
+	android.AssertStringDoesContain(t, "target-files metadata must consume the same salt",
+		miscInfoSource, "--salt {CONTENTS_OF:")
+	android.AssertStringDoesContain(t, "target-files salt must use the generated salt file",
+		miscInfoSource, "/avb_salt}")
+	android.AssertStringDoesContain(t, "target-files metadata must retain the DTBO fingerprint",
+		miscInfoSource, "--prop com.android.build.dtbo.fingerprint:{CONTENTS_OF:")
+
+	miscInfoImplicits := module.Output("prop_file_for_misc_info").Implicits.Strings()
+	android.AssertStringListContains(t, "generated salt must be a misc-info dependency",
+		miscInfoImplicits, saltOutput)
+}
+
