+func TestSelectBootloaderUnpackTool(t *testing.T) {
+	adevtoolTool := "vendor/adevtool/config/mk/google_devices/platform/malibu/fbpacktool.py"
+	googleTool := "vendor/google_devices/malibu/prebuilts/misc_bins/fbimg/fbpacktool.py"
+	tests := []struct {
+		name       string
+		existing   map[string]bool
+		wantTool   string
+		wantDeps   []string
+		wantExists bool
+	}{
+		{
+			name:       "prefer adevtool adapter",
+			existing:   map[string]bool{adevtoolTool: true, googleTool: true},
+			wantTool:   adevtoolTool,
+			wantDeps:   []string{"vendor/adevtool/config/mk/google_devices/platform/malibu/*.py"},
+			wantExists: true,
+		},
+		{
+			name:       "fall back to Google prebuilts",
+			existing:   map[string]bool{googleTool: true},
+			wantTool:   googleTool,
+			wantDeps:   []string{"vendor/google_devices/malibu/prebuilts/misc_bins/fbimg/*.py"},
+			wantExists: true,
+		},
+		{
+			name:       "reject missing tools",
+			existing:   map[string]bool{},
+			wantExists: false,
+		},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			got, exists := selectBootloaderUnpackTool("malibu", func(path string) bool {
+				return test.existing[path]
+			})
+			android.AssertBoolEquals(t, "tool existence", test.wantExists, exists)
+			android.AssertStringEquals(t, "selected tool", test.wantTool, got.tool)
+			android.AssertArrayString(t, "selected tool dependencies", test.wantDeps, got.deps)
+		})
+	}
+}
