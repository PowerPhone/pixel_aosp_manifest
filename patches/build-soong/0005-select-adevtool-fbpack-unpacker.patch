+type bootloaderUnpackTool struct {
+	tool string
+	deps []string
+}
+
+func selectBootloaderUnpackTool(boardPlatform string, exists func(string) bool) (bootloaderUnpackTool, bool) {
+	if boardPlatform == "" {
+		return bootloaderUnpackTool{}, false
+	}
+
+	toolCandidates := []string{
+		filepath.Join("vendor/adevtool/config/mk/google_devices/platform", boardPlatform, "fbpacktool.py"),
+		filepath.Join("vendor/google_devices", boardPlatform, "prebuilts/misc_bins/fbimg/fbpacktool.py"),
+	}
+	for _, tool := range toolCandidates {
+		if exists(tool) {
+			return bootloaderUnpackTool{
+				tool: tool,
+				deps: []string{filepath.Join(filepath.Dir(tool), "*.py")},
+			}, true
+		}
+	}
+	return bootloaderUnpackTool{}, false
+}
