+func TestPrebuiltBootloaderDeterministicCarrier(t *testing.T) {
+	t.Parallel()
+	result := android.GroupFixturePreparers(
+		fixture,
+		android.PrepareForTestWithHostTools("avbtool", "avb_openssl"),
+		android.FixtureModifyProductVariables(func(variables android.FixtureProductVariables) {
+			variables.BuildNumberFile = proptools.StringPtr("build_number.txt")
+		}),
+		android.FixtureRegisterWithContext(func(ctx android.RegistrationContext) {
+			ctx.RegisterModuleType("prebuilt_bootloader", PrebuiltBootloaderFactory)
+		}),
+		android.FixtureMergeMockFs(android.MockFS{
+			"bootloader.img": nil,
+			"fbpacktool.py":  nil,
+		}),
+	).RunTestWithBp(t, `
+		prebuilt_bootloader {
+			name: "mybootloader",
+			src: "bootloader.img",
+			ab_ota_partitions: ["abl"],
+			unpack_tool: "fbpacktool.py",
+		}
+	`)
+
+	module := result.ModuleForTests(t, "mybootloader", "android_arm64_armv8-a")
+	rule := module.Rule("unpack_bootloader")
+	for _, suffix := range []string{"build_number.txt", "build_date.txt"} {
+		foundImplicit := false
+		for _, input := range rule.Implicits.Strings() {
+			foundImplicit = foundImplicit || strings.HasSuffix(input, suffix)
+		}
+		android.AssertBoolEquals(t, suffix+" must be a normal carrier dependency", true, foundImplicit)
+		for _, input := range rule.OrderOnly.Strings() {
+			if strings.HasSuffix(input, suffix) {
+				t.Errorf("%s must not remain order-only: %v", suffix, rule.OrderOnly.Strings())
+			}
+		}
+	}
+
+	manifest := android.RuleBuilderSboxProtoForTests(t, result.TestContext,
+		module.Output("unpack_bootloader.textproto"))
+	var commands []string
+	for _, command := range manifest.Commands {
+		commands = append(commands, command.GetCommand())
+	}
+	command := strings.Join(commands, "\n")
+	android.AssertStringDoesContain(t, "carrier salt derivation changed", command,
+		`--salt $(sha256sum "__SBOX_SANDBOX_DIR__/out/soong/build_number.txt" "__SBOX_SANDBOX_DIR__/out/build_date.txt" | cut -d " " -f 1 | tr -d '\n')`)
+	android.AssertStringDoesContain(t, "carrier partition-size expression changed", command,
+		`--partition_size $(( 69632 + (( $(stat -c %s __SBOX_SANDBOX_DIR__/out/abl.img) - 1) / 4096 + 1) * 4096 ))`)
+}
