+malibu_avb_firmware_partitions := \
+    abl \
+    bl31 \
+    cap \
+    cpm \
+    dbc \
+    dbl \
+    dram_init_0 \
+    dram_init_1 \
+    dram_init_10 \
+    dram_init_11 \
+    dram_init_2 \
+    dram_init_3 \
+    dram_init_4 \
+    dram_init_5 \
+    dram_init_6 \
+    dram_init_7 \
+    dram_init_8 \
+    dram_init_9 \
+    dram_phy \
+    gc \
+    gdmc \
+    gsa_bl1 \
+    gsa_fw \
+    tzsw
+
+ifneq ($(AB_OTA_BOOTLOADER_PARTITIONS),$(malibu_avb_firmware_partitions))
+$(error Malibu AB_OTA_BOOTLOADER_PARTITIONS must match its reviewed AVB firmware list)
+endif
+
+malibu_bootloader_firmware_dir := $(patsubst %/,%,$(dir $(BOOTLOADER_FILE_PATH)))
+malibu_avb_firmware_carriers := $(addprefix $(PRODUCT_OUT)/,$(addsuffix _vbfooted.img,$(malibu_avb_firmware_partitions)))
+
+# Match filesystem/prebuilt_bootloader: preserve each raw blob, then append a
+# deterministic AVB hash footer to a carrier copy. The 68 KiB allowance is the
+# upstream 64 KiB maximum-vbmeta reservation plus one 4 KiB footer block.
+$(malibu_avb_firmware_carriers): $(PRODUCT_OUT)/%_vbfooted.img: $(malibu_bootloader_firmware_dir)/%.img $(AVBTOOL) $(BUILD_NUMBER_FILE) $(BUILD_DATETIME_FILE)
+	$(hide) mkdir -p $(dir $@)
+	$(hide) cp $< $@
+	$(hide) $(AVBTOOL) add_hash_footer \
+	    --image $@ \
+	    --partition_name $* \
+	    --salt $$(sha256sum "$(BUILD_NUMBER_FILE)" "$(BUILD_DATETIME_FILE)" | cut -d " " -f 1 | tr -d '\n') \
+	    --partition_size $$(( 69632 + ( ($$(stat -c %s "$<") + 4095) / 4096) * 4096 ))
+
+INSTALLED_RADIOIMAGE_TARGET += $(malibu_avb_firmware_carriers)
+BOARD_AVB_MAKE_VBMETA_IMAGE_ARGS += $(foreach image,$(malibu_avb_firmware_carriers),--include_descriptors_from_image $(image))
+$(PRODUCT_OUT)/vbmeta.img: $(malibu_avb_firmware_carriers)
