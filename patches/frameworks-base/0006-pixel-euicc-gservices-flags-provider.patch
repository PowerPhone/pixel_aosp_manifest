+package org.pixelaosp.gservicesflags;
+
+import android.content.ContentProvider;
+import android.content.ContentValues;
+import android.content.pm.ApplicationInfo;
+import android.content.pm.PackageManager;
+import android.database.Cursor;
+import android.database.MatrixCursor;
+import android.net.Uri;
+import android.os.Binder;
+import android.os.Process;
+import android.util.Log;
+
+import java.io.BufferedReader;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.IOException;
+import java.io.InputStreamReader;
+import java.nio.charset.StandardCharsets;
+import java.util.Map;
+import java.util.TreeMap;
+
+/**
+ * Read-only Gservices flags provider for the stock Pixel eUICC support app.
+ *
+ * <p>Pristine AOSP has no Google Services Framework provider. Adevtool
+ * nevertheless extracts the small, device-specific flag set needed by the
+ * stock eUICC firmware helper. This provider exposes only those pinned flags
+ * and accepts calls only from the exact privileged stock package.</p>
+ */
+public final class GservicesFlagsProvider extends ContentProvider {
+    private static final String TAG = "PixelAospGservices";
+    private static final String ALLOWED_PACKAGE = "com.google.euiccpixel";
+    private static final File FLAGS_FILE = new File(
+            "/system_ext/etc/gmscompat/gservices-flags/flags.txt");
+    private static final String[] COLUMNS = {"key", "value"};
+
+    private volatile Map<String, String> mFlags;
+
+    @Override
+    public boolean onCreate() {
+        return true;
+    }
+
+    @Override
+    public Cursor query(Uri uri, String[] projection, String selection,
+            String[] selectionArgs, String sortOrder) {
+        enforceAllowedCaller();
+
+        MatrixCursor cursor = new MatrixCursor(COLUMNS);
+        Map<String, String> flags = getFlags();
+        if (isPrefixQuery(uri)) {
+            if (selectionArgs != null) {
+                for (Map.Entry<String, String> entry : flags.entrySet()) {
+                    if (startsWithAny(entry.getKey(), selectionArgs)) {
+                        cursor.addRow(new Object[] {entry.getKey(), entry.getValue()});
+                    }
+                }
+            }
+        } else if (selectionArgs != null && selectionArgs.length > 0) {
+            String key = selectionArgs[0];
+            String value = flags.get(key);
+            if (value != null) {
+                cursor.addRow(new Object[] {key, value});
+            }
+        }
+        return cursor;
+    }
+
+    @Override
+    public String getType(Uri uri) {
+        return null;
+    }
+
+    @Override
+    public Uri insert(Uri uri, ContentValues values) {
+        throw new UnsupportedOperationException("read-only provider");
+    }
+
+    @Override
+    public int delete(Uri uri, String selection, String[] selectionArgs) {
+        throw new UnsupportedOperationException("read-only provider");
+    }
+
+    @Override
+    public int update(Uri uri, ContentValues values, String selection,
+            String[] selectionArgs) {
+        throw new UnsupportedOperationException("read-only provider");
+    }
+
+    private void enforceAllowedCaller() {
+        int uid = Binder.getCallingUid();
+        if (uid == Process.myUid() || uid == Process.SYSTEM_UID || uid == Process.ROOT_UID) {
+            return;
+        }
+
+        PackageManager packageManager = getContext().getPackageManager();
+        String[] packages = packageManager.getPackagesForUid(uid);
+        if (packages != null) {
+            for (String packageName : packages) {
+                if (!ALLOWED_PACKAGE.equals(packageName)) {
+                    continue;
+                }
+                try {
+                    ApplicationInfo app = packageManager.getApplicationInfo(packageName, 0);
+                    boolean system = (app.flags & ApplicationInfo.FLAG_SYSTEM) != 0;
+                    boolean privileged =
+                            (app.privateFlags & ApplicationInfo.PRIVATE_FLAG_PRIVILEGED) != 0;
+                    if (app.uid == uid && system && privileged) {
+                        return;
+                    }
+                } catch (PackageManager.NameNotFoundException ignored) {
+                    // Reject below.
+                }
+            }
+        }
+        throw new SecurityException("caller is not the privileged Pixel eUICC support app");
+    }
+
+    private Map<String, String> getFlags() {
+        Map<String, String> flags = mFlags;
+        if (flags != null) {
+            return flags;
+        }
+        synchronized (this) {
+            flags = mFlags;
+            if (flags == null) {
+                flags = loadFlags();
+                mFlags = flags;
+            }
+        }
+        return flags;
+    }
+
+    private static Map<String, String> loadFlags() {
+        TreeMap<String, String> flags = new TreeMap<>();
+        try (BufferedReader reader = new BufferedReader(new InputStreamReader(
+                new FileInputStream(FLAGS_FILE), StandardCharsets.UTF_8))) {
+            String line;
+            while ((line = reader.readLine()) != null) {
+                int separator = firstWhitespace(line);
+                if (separator <= 0) {
+                    continue;
+                }
+                String key = line.substring(0, separator);
+                int valueStart = separator;
+                while (valueStart < line.length()
+                        && Character.isWhitespace(line.charAt(valueStart))) {
+                    valueStart++;
+                }
+                if (valueStart < line.length()) {
+                    flags.put(key, line.substring(valueStart));
+                }
+            }
+        } catch (IOException e) {
+            Log.e(TAG, "Unable to read " + FLAGS_FILE, e);
+        }
+        return flags;
+    }
+
+    private static int firstWhitespace(String value) {
+        for (int i = 0; i < value.length(); i++) {
+            if (Character.isWhitespace(value.charAt(i))) {
+                return i;
+            }
+        }
+        return -1;
+    }
+
+    private static boolean isPrefixQuery(Uri uri) {
+        return uri.getPathSegments().size() == 1
+                && "prefix".equals(uri.getPathSegments().get(0));
+    }
+
+    private static boolean startsWithAny(String key, String[] prefixes) {
+        for (String prefix : prefixes) {
+            if (prefix != null && key.startsWith(prefix)) {
+                return true;
+            }
+        }
+        return false;
+    }
+}
