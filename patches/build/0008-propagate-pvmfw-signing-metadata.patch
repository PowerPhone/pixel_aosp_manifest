 import os
 import os.path
 import tempfile
+from unittest import mock
 import zipfile
 
 import common
 import test_utils
 from add_img_to_target_files import (
-    AddPackRadioImages,
+    AddPackRadioImages, AddPvmfw,
     AddCareMapForAbOta, GetCareMap,
     CheckAbOtaImages)
 from rangelib import RangeSet
@@ -121,6 +122,31 @@ class AddImagesToTargetFilesTest(test_utils.ReleaseToolsTestCase):
     self.assertRaises(AssertionError, AddPackRadioImages, None,
                       images + ['baz'])
 
+  @mock.patch('common.RunAndCheckOutput')
+  def test_AddPvmfw_signingOnlyMetadata(self, run_and_check_output):
+    self._create_images(['pvmfw'], 'PREBUILT_IMAGES')
+    signing_key = common.MakeTempFile(prefix='pvmfw-', suffix='.pem')
+    with open(signing_key, 'w') as signing_key_file:
+      signing_key_file.write('test key')
+    expected_salt = '00' * 32
+    OPTIONS.info_dict = {
+        'avb_enable': 'true',
+        'avb_avbtool': 'avbtool',
+        'avb_salt': '11' * 32,
+        'pvmfw_size': '1048576',
+        'avb_pvmfw_signing_key_path': signing_key,
+        'avb_pvmfw_signing_algorithm': 'SHA256_RSA4096',
+        'avb_pvmfw_add_hash_footer_args': '--salt ' + expected_salt,
+    }
+
+    AddPvmfw(None)
+
+    cmd = run_and_check_output.call_args.args[0]
+    self.assertEqual(signing_key, cmd[cmd.index('--key') + 1])
+    self.assertEqual('SHA256_RSA4096', cmd[cmd.index('--algorithm') + 1])
+    self.assertEqual(1, cmd.count('--salt'))
+    self.assertEqual(expected_salt, cmd[cmd.index('--salt') + 1])
+
   @staticmethod
   def _test_AddCareMapForAbOta():
     """Helper function to set up the test for test_AddCareMapForAbOta()."""
