+  def test_ReplaceAvbSigningKeys_pvmfwSigningOnlyMetadata(self):
+    misc_info = {
+        'avb_pvmfw_signing_key_path': 'old-key.pem',
+        'avb_pvmfw_signing_algorithm': 'SHA256_RSA4096',
+    }
+    old_keys = common.OPTIONS.avb_keys
+    old_algorithms = common.OPTIONS.avb_algorithms
+    old_extra_args = common.OPTIONS.avb_extra_args
+    try:
+      common.OPTIONS.avb_keys = {'pvmfw': 'new-key.pem'}
+      common.OPTIONS.avb_algorithms = {'pvmfw': 'SHA512_RSA4096'}
+      common.OPTIONS.avb_extra_args = {}
+      ReplaceAvbSigningKeys(misc_info)
+    finally:
+      common.OPTIONS.avb_keys = old_keys
+      common.OPTIONS.avb_algorithms = old_algorithms
+      common.OPTIONS.avb_extra_args = old_extra_args
+
+    self.assertEqual('new-key.pem', misc_info['avb_pvmfw_signing_key_path'])
+    self.assertEqual(
+        'SHA512_RSA4096', misc_info['avb_pvmfw_signing_algorithm'])
+    self.assertNotIn('avb_pvmfw_key_path', misc_info)
+    self.assertNotIn('avb_pvmfw_algorithm', misc_info)
+
   def test_RewriteAvbProps(self):
     misc_info = {
       'avb_boot_add_hash_footer_args':
@@ -536,4 +561,3 @@ name="apex.apexd_test_different_app.apex" public_key="system/apex/apexd/apexd_te
             'system/apex/apexd/apexd_testdata/com.android.apex.test_package_2.pem',
             'build/make/target/product/security/testkey', None),
