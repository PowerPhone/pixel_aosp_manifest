From a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7 Mon Sep 17 00:00:00 2001
From: Pixel AOSP maintainers <pixel-aosp@example.invalid>
Date: Fri, 28 Aug 2026 13:55:00 -0400
Subject: [PATCH] Propagate Make boot salts to target files

Make signs init_boot, vendor_boot, and vendor_kernel_boot with the
concatenated SHA-256 digests of the build-number and build-date files. The
corresponding misc_info entries omit that salt, so releasetools falls back to
the build-fingerprint digest and reconstructs different images and root AVB
descriptors.

Emit the same identity-derived salt for each Make-signed boot partition in
misc_info, and make both the direct images and metadata depend normally on
the identity files. This keeps direct product images, target-files IMAGES,
and img_from_target_files output byte-identical across incremental builds.

This is a project-authored reproducibility fix for android-17.0.0_r1.
License: Apache-2.0 (platform/build)
---
 core/Makefile | 24 +++++++++++++++++-------
 1 file changed, 17 insertions(+), 7 deletions(-)

diff --git a/core/Makefile b/core/Makefile
--- a/core/Makefile
+++ b/core/Makefile
@@ -1568,7 +1568,8 @@ ifdef INTERNAL_INIT_BOOT_IMAGE_PAGESIZE
 endif
 
 ifeq ($(BOARD_AVB_ENABLE),true)
-$(INSTALLED_INIT_BOOT_IMAGE_TARGET): $(AVBTOOL) $(BOARD_AVB_INIT_BOOT_KEY_PATH)
+$(INSTALLED_INIT_BOOT_IMAGE_TARGET): $(AVBTOOL) $(BOARD_AVB_INIT_BOOT_KEY_PATH) \
+    $(BUILD_NUMBER_FILE) $(BUILD_DATETIME_FILE)
 	$(call pretty,"Target init_boot image: $@")
 	$(MKBOOTIMG) $(INTERNAL_INIT_BOOT_IMAGE_ARGS) $(INTERNAL_MKBOOTIMG_VERSION_ARGS) $(BOARD_MKBOOTIMG_INIT_ARGS) --output "$@"
 	$(call assert-max-image-size,$@,$(BOARD_INIT_BOOT_IMAGE_PARTITION_SIZE))
@@ -1751,7 +1752,8 @@ INSTALLED_VENDOR_BOOTIMAGE_TARGET := $(PRODUCT_OUT)/vendor_boot.img
 $(INSTALLED_VENDOR_BOOTIMAGE_TARGET): $(MKBOOTIMG) $(INTERNAL_VENDOR_RAMDISK_TARGET) $(INSTALLED_DTBIMAGE_TARGET)
 $(INSTALLED_VENDOR_BOOTIMAGE_TARGET): $(INTERNAL_VENDOR_RAMDISK_FRAGMENT_TARGETS) $(INTERNAL_VENDOR_BOOTCONFIG_TARGET)
 ifeq ($(BOARD_AVB_ENABLE),true)
-$(INSTALLED_VENDOR_BOOTIMAGE_TARGET): $(AVBTOOL) $(BOARD_AVB_VENDOR_BOOTIMAGE_KEY_PATH)
+$(INSTALLED_VENDOR_BOOTIMAGE_TARGET): $(AVBTOOL) $(BOARD_AVB_VENDOR_BOOTIMAGE_KEY_PATH) \
+    $(BUILD_NUMBER_FILE) $(BUILD_DATETIME_FILE)
 	$(call pretty,"Target vendor_boot image: $@")
 	$(MKBOOTIMG) $(INTERNAL_VENDOR_BOOTIMAGE_ARGS) $(BOARD_MKBOOTIMG_ARGS) --vendor_ramdisk $(INTERNAL_VENDOR_RAMDISK_TARGET) $(INTERNAL_VENDOR_RAMDISK_FRAGMENT_ARGS) --vendor_boot $@
 	$(call assert-max-image-size,$@,$(call get-hash-image-max-size,$(BOARD_VENDOR_BOOTIMAGE_PARTITION_SIZE)))
@@ -1842,7 +1844,8 @@ endif
 
 
 ifeq ($(BOARD_AVB_ENABLE),true)
-$(INSTALLED_VENDOR_KERNEL_BOOTIMAGE_TARGET): $(AVBTOOL) $(BOARD_AVB_VENDOR_KERNEL_BOOT_KEY_PATH)
+$(INSTALLED_VENDOR_KERNEL_BOOTIMAGE_TARGET): $(AVBTOOL) $(BOARD_AVB_VENDOR_KERNEL_BOOT_KEY_PATH) \
+    $(BUILD_NUMBER_FILE) $(BUILD_DATETIME_FILE)
 	$(call pretty,"Target vendor_kernel_boot image: $@")
 	$(MKBOOTIMG) $(INTERNAL_VENDOR_KERNEL_BOOTIMAGE_ARGS) $(BOARD_MKBOOTIMG_ARGS) --vendor_boot $@
 	$(call assert-max-image-size,$@,$(BOARD_VENDOR_KERNEL_BOOTIMAGE_PARTITION_SIZE))
@@ -1873,7 +1876,9 @@ INTERNAL_PREBUILT_VENDOR_KERNEL_BOOTIMAGE := $(BOARD_PREBUILT_VENDOR_KERNEL_BOOT
 INSTALLED_VENDOR_KERNEL_BOOTIMAGE_TARGET := $(PRODUCT_OUT)/vendor_kernel_boot.img
 
 ifeq ($(BOARD_AVB_ENABLE),true)
-$(INSTALLED_VENDOR_KERNEL_BOOTIMAGE_TARGET): $(INTERNAL_PREBUILT_VENDOR_KERNEL_BOOTIMAGE) $(AVBTOOL) $(BOARD_AVB_VENDOR_KERNEL_BOOT_KEY_PATH)
+$(INSTALLED_VENDOR_KERNEL_BOOTIMAGE_TARGET): $(INTERNAL_PREBUILT_VENDOR_KERNEL_BOOTIMAGE) \
+    $(AVBTOOL) $(BOARD_AVB_VENDOR_KERNEL_BOOT_KEY_PATH) \
+    $(BUILD_NUMBER_FILE) $(BUILD_DATETIME_FILE)
 	cp $(INTERNAL_PREBUILT_VENDOR_KERNEL_BOOTIMAGE) $@
 	chmod +w $@
 	$(AVBTOOL) add_hash_footer \
@@ -6087,6 +6092,10 @@ endif
 
 INSTALLED_MISC_INFO_TARGET := $(PRODUCT_OUT)/misc_info.txt
 
+ifeq ($(BOARD_AVB_ENABLE),true)
+$(INSTALLED_MISC_INFO_TARGET): $(BUILD_NUMBER_FILE) $(BUILD_DATETIME_FILE)
+endif
+
 ifdef BOARD_PREBUILT_DTBOIMAGE
 ifeq ($(BOARD_AVB_ENABLE),true)
 $(INSTALLED_MISC_INFO_TARGET): $(BUILD_FINGERPRINT_FILE) \
@@ -6206,19 +6215,19 @@ ifdef BOARD_AVB_BOOT_KEY_PATH
 	$(hide) echo "avb_boot_algorithm=$(BOARD_AVB_BOOT_ALGORITHM)" >> $@
 	$(hide) echo "avb_boot_rollback_index_location=$(BOARD_AVB_BOOT_ROLLBACK_INDEX_LOCATION)" >> $@
 endif # BOARD_AVB_BOOT_KEY_PATH
-	$(hide) echo "avb_init_boot_add_hash_footer_args=$(BOARD_AVB_INIT_BOOT_ADD_HASH_FOOTER_ARGS)" >> $@
+	$(hide) echo "avb_init_boot_add_hash_footer_args=$(if $(filter true,$(BUILDING_INIT_BOOT_IMAGE)),--salt $$(sha256sum $(BUILD_NUMBER_FILE) $(BUILD_DATETIME_FILE) | cut -d ' ' -f 1 | tr -d '\n') )$(BOARD_AVB_INIT_BOOT_ADD_HASH_FOOTER_ARGS)" >> $@
 ifdef BOARD_AVB_INIT_BOOT_KEY_PATH
 	$(hide) echo "avb_init_boot_key_path=$(BOARD_AVB_INIT_BOOT_KEY_PATH)" >> $@
 	$(hide) echo "avb_init_boot_algorithm=$(BOARD_AVB_INIT_BOOT_ALGORITHM)" >> $@
 	$(hide) echo "avb_init_boot_rollback_index_location=$(BOARD_AVB_INIT_BOOT_ROLLBACK_INDEX_LOCATION)" >> $@
 endif # BOARD_AVB_INIT_BOOT_KEY_PATH
-	echo "avb_vendor_boot_add_hash_footer_args=$(BOARD_AVB_VENDOR_BOOT_ADD_HASH_FOOTER_ARGS)" >> $@
+	echo "avb_vendor_boot_add_hash_footer_args=$(if $(filter true,$(BUILDING_VENDOR_BOOT_IMAGE)),--salt $$(sha256sum $(BUILD_NUMBER_FILE) $(BUILD_DATETIME_FILE) | cut -d ' ' -f 1 | tr -d '\n') )$(BOARD_AVB_VENDOR_BOOT_ADD_HASH_FOOTER_ARGS)" >> $@
 ifdef BOARD_AVB_VENDOR_BOOT_KEY_PATH
 	echo "avb_vendor_boot_key_path=$(BOARD_AVB_VENDOR_BOOT_KEY_PATH)" >> $@
 	echo "avb_vendor_boot_algorithm=$(BOARD_AVB_VENDOR_BOOT_ALGORITHM)" >> $@
 	echo "avb_vendor_boot_rollback_index_location=$(BOARD_AVB_VENDOR_BOOT_ROLLBACK_INDEX_LOCATION)" >> $@
 endif # BOARD_AVB_VENDOR_BOOT_KEY_PATH
-	echo "avb_vendor_kernel_boot_add_hash_footer_args=$(BOARD_AVB_VENDOR_KERNEL_BOOT_ADD_HASH_FOOTER_ARGS)" >> $@
+	echo "avb_vendor_kernel_boot_add_hash_footer_args=$(if $(strip $(filter true,$(BUILDING_VENDOR_KERNEL_BOOT_IMAGE)) $(BOARD_PREBUILT_VENDOR_KERNEL_BOOT_IMAGE)),--salt $$(sha256sum $(BUILD_NUMBER_FILE) $(BUILD_DATETIME_FILE) | cut -d ' ' -f 1 | tr -d '\n') )$(BOARD_AVB_VENDOR_KERNEL_BOOT_ADD_HASH_FOOTER_ARGS)" >> $@
 ifdef BOARD_AVB_VENDOR_KERNEL_BOOT_KEY_PATH
 	echo "avb_vendor_kernel_boot_key_path=$(BOARD_AVB_VENDOR_KERNEL_BOOT_KEY_PATH)" >> $@
 	echo "avb_vendor_kernel_boot_algorithm=$(BOARD_AVB_VENDOR_KERNEL_BOOT_ALGORITHM)" >> $@
