<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <!--
    Device bring-up projects not present in the AOSP manifest. Revisions are
    immutable commits so a later upstream branch update cannot silently alter a
    build. Generated proprietary output remains local and is never committed.
  -->
  <remote name="grapheneos" fetch="https://github.com/GrapheneOS/" />

  <project
      path="vendor/adevtool"
      name="adevtool"
      remote="grapheneos"
      revision="b01ccecab3468f3bcfa0d23adc361ad074989674"
      clone-depth="1" />

  <!-- Reference module state used to classify source-buildable vs proprietary files. -->
  <project
      path="vendor/state"
      name="vendor_state"
      remote="grapheneos"
      revision="afd6a0c9f6ca13d395f00e98227a0866cc14de07"
      clone-depth="1" />

  <!-- adevtool host dependency used for resource-table inspection. -->
  <project
      path="tools/arsclib"
      name="platform_tools_arsclib"
      remote="grapheneos"
      revision="a67388430c8319f4c7066626e340b5c4d7f27882"
      clone-depth="1" />

  <!-- Pixel product makefiles expect the source-built CarrierConfig2 module. -->
  <project
      path="packages/apps/CarrierConfig2"
      name="platform_packages_apps_CarrierConfig2"
      remote="grapheneos"
      revision="9d56beab5824252e6fcdd09c04726d276343b247"
      clone-depth="1" />
</manifest>
