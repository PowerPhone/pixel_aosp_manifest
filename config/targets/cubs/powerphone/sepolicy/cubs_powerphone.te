type cubs_powerphone_boot, domain;
type cubs_powerphone_boot_exec, exec_type, vendor_file_type, file_type;
type powerphone_cubs_data_file, file_type, data_file_type;
type powerphone_cubs_marker_file, file_type, dev_type;
vendor_internal_prop(vendor_powerphone_cubs_prop)
init_daemon_domain(cubs_powerphone_boot)

set_prop(cubs_powerphone_boot, vendor_powerphone_cubs_prop)
set_prop(vendor_init, vendor_powerphone_cubs_prop)
get_prop(hal_audio_default, vendor_powerphone_cubs_prop)
allow cubs_powerphone_boot kmsg_debug_device:chr_file { w_file_perms getattr ioctl };
allow cubs_powerphone_boot aoc_device:chr_file rw_file_perms;
allow cubs_powerphone_boot audio_device:dir r_dir_perms;
allow cubs_powerphone_boot audio_device:chr_file rw_file_perms;
allow cubs_powerphone_boot sysfs_aoc:dir search;
allow cubs_powerphone_boot sysfs_aoc_dumpstate:file r_file_perms;
allow hal_audio_default sysfs_aoc_dumpstate:file r_file_perms;
# PCM ownership is queried through controlC0's PCM_INFO ioctl; no process
# traversal, ptrace capability or verbose ALSA procfs build is required.
allow cubs_powerphone_boot powerphone_cubs_data_file:dir rw_dir_perms;
allow cubs_powerphone_boot powerphone_cubs_data_file:file create_file_perms;
allow cubs_powerphone_boot device:dir { search write add_name remove_name };
allow cubs_powerphone_boot powerphone_cubs_marker_file:file create_file_perms;
type_transition cubs_powerphone_boot device:file powerphone_cubs_marker_file "powerphone-cubs-mono192";
type_transition cubs_powerphone_boot device:file powerphone_cubs_marker_file "powerphone-cubs-direct192";
type_transition cubs_powerphone_boot device:file powerphone_cubs_marker_file "powerphone-cubs-tdm-slots";
allow hal_audio_default powerphone_cubs_marker_file:file r_file_perms;
