type powerphone_pdm_loader, domain;
type powerphone_pdm_loader_exec, exec_type, vendor_file_type, file_type;
type vendor_powerphone_pdm_sysfs, fs_type, sysfs_type;
vendor_internal_prop(vendor_powerphone_pdm_prop)
vendor_internal_prop(vendor_powerphone_pdm_topology_prop)
vendor_internal_prop(vendor_powerphone_aoc_speaker_prop)

# The always-registered additive audio HAL independently gates capture and
# speaker stream start/transfer on these two boot-volatile properties. The PDM
# loader can set neither data-ready gate; a future lease broker and a separate
# AoC certifier must own them after their respective live qualifications.
get_prop(hal_audio_default, vendor_powerphone_pdm_prop)
get_prop(hal_audio_default, vendor_powerphone_aoc_speaker_prop)

init_daemon_domain(powerphone_pdm_loader)

# The loader owns one build-staged module and never invokes a general module
# dependency resolver. Runtime provenance relies on the research image's AVB
# boundary; the module itself does not carry an OEM signature.
allow powerphone_pdm_loader self:global_capability_class_set sys_module;
allow powerphone_pdm_loader kernel:key search;
r_dir_file(powerphone_pdm_loader, vendor_kernel_modules)
allow powerphone_pdm_loader vendor_kernel_modules:system module_load;

# Read-only validation of exact ALSA card IDs/topology and only this module's
# parameters. The loader never writes procfs, sysfs, or MMIO.
r_dir_file(powerphone_pdm_loader, proc_asound)
r_dir_file(powerphone_pdm_loader, vendor_powerphone_pdm_sysfs)

# pcm_params_get performs HW_REFINE on each fixed capture node. It neither
# prepares nor starts a PCM, and polling_enabled remains zero throughout.
allow powerphone_pdm_loader audio_device:dir r_dir_perms;
allow powerphone_pdm_loader audio_device:chr_file rw_file_perms;

# The loader certifies only inert module/card topology. A future lease broker
# must own vendor.powerphone.pdm.ready after proving the data path is active.
set_prop(powerphone_pdm_loader, vendor_powerphone_pdm_topology_prop)
