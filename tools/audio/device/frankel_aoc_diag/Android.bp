package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_binary {
    name: "frankel_aoc_diag",
    vendor: true,
    srcs: ["frankel_aoc_diag.cpp"],
    cpp_std: "c++20",
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}
