// SPDX-License-Identifier: Apache-2.0

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_binary {
    name: "frankel_aoc_speaker_patch",
    vendor: true,
    srcs: [
        "frankel_aoc_speaker_patch.cpp",
        "patch_model.cpp",
    ],
    shared_libs: ["libtinyalsa"],
    cpp_std: "c++20",
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}

cc_binary_host {
    name: "frankel_aoc_speaker_patch_host_test",
    srcs: [
        "patch_model.cpp",
        "patch_model_test.cpp",
    ],
    cpp_std: "c++20",
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}
