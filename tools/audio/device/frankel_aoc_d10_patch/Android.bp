package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_binary {
    name: "frankel_aoc_d10_patch",
    vendor: true,
    srcs: ["frankel_aoc_d10_patch.cpp"],
    shared_libs: ["libtinyalsa"],
    cpp_std: "c++20",
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}
